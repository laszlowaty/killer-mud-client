<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudClient.App.ViewModels"
             xmlns:models="using:MudClient.App.Models"
             xmlns:controls="using:MudClient.App.Controls"
             x:Name="MobileAutomationRoot"
             x:Class="MudClient.Android.Views.MobileAutomationView"
             x:DataType="vm:MainWindowViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="TimerItemTemplate" x:DataType="models:TimerEntry">
      <Border Classes="mud-section" Padding="12" Margin="0,3">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding IntervalText}" Classes="mud-faint" />
          <TextBlock Text="{Binding LastError}"
                     Foreground="{StaticResource MudBrushCrimsonBright}"
                     IsVisible="{Binding HasLastError}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <ToggleButton Grid.Column="0"
                          Content="{Binding StatusText}"
                          Command="{Binding DataContext.ToggleTimerCommand, ElementName=MobileAutomationRoot}"
                          CommandParameter="{Binding}"
                          HorizontalAlignment="Left"
                          MinWidth="120"
                          MinHeight="44" />
            <Button Grid.Column="1"
                    Content="✎"
                    Command="{Binding DataContext.EditTimerCommand, ElementName=MobileAutomationRoot}"
                    CommandParameter="{Binding}"
                    MinWidth="44"
                    MinHeight="44" />
            <Button Grid.Column="2"
                    Content="✕"
                    Classes="mud-danger"
                    Command="{Binding DataContext.DeleteTimerCommand, ElementName=MobileAutomationRoot}"
                    CommandParameter="{Binding}"
                    MinWidth="44"
                    MinHeight="44" />
          </Grid>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="RuleItemTemplate" x:DataType="models:AutomationRuleEntry">
      <Border Classes="mud-section" Padding="12" Margin="0,3">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding LastError}"
                     Foreground="{StaticResource MudBrushCrimsonBright}"
                     IsVisible="{Binding HasLastError}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <ToggleButton Grid.Column="0"
                        Content="{Binding StatusText}"
                        Command="{Binding DataContext.ToggleRuleCommand, ElementName=MobileAutomationRoot}"
                        CommandParameter="{Binding}"
                        HorizontalAlignment="Left"
                        MinWidth="120"
                        MinHeight="44" />
            <Button Grid.Column="1"
                  Content="✎"
                  Command="{Binding DataContext.EditRuleCommand, ElementName=MobileAutomationRoot}"
                  CommandParameter="{Binding}"
                  MinWidth="44"
                  MinHeight="44" />
            <Button Grid.Column="2"
                  Content="✕"
                  Classes="mud-danger"
                  Command="{Binding DataContext.DeleteRuleCommand, ElementName=MobileAutomationRoot}"
                  CommandParameter="{Binding}"
                  MinWidth="44"
                  MinHeight="44" />
          </Grid>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ScriptItemTemplate" x:DataType="models:ScriptEntry">
      <Border Classes="mud-section" Padding="12" Margin="0,3">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding LastError}"
                     Foreground="{StaticResource MudBrushCrimsonBright}"
                     IsVisible="{Binding HasLastError}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
            <ToggleButton Content="{Binding StatusText}"
                          Command="{Binding DataContext.ToggleScriptCommand, ElementName=MobileAutomationRoot}"
                          CommandParameter="{Binding}"
                          HorizontalAlignment="Left" MinWidth="110" MinHeight="44" />
            <Button Grid.Column="1" Content="▶"
                    Command="{Binding DataContext.RunScriptCommand, ElementName=MobileAutomationRoot}"
                    CommandParameter="{Binding}" MinWidth="44" MinHeight="44" />
            <Button Grid.Column="2" Content="✎"
                    Command="{Binding DataContext.EditScriptCommand, ElementName=MobileAutomationRoot}"
                    CommandParameter="{Binding}" MinWidth="44" MinHeight="44" />
            <Button Grid.Column="3" Content="✕" Classes="mud-danger"
                    Command="{Binding DataContext.DeleteScriptCommand, ElementName=MobileAutomationRoot}"
                    CommandParameter="{Binding}" MinWidth="44" MinHeight="44" />
          </Grid>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <TabControl SelectedIndex="{Binding SelectedAutomationTabIndex, Mode=TwoWay}"
              Classes="mud-subtabs"
              Margin="12">
    <TabItem Header="Timery">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
          <Button Content="＋ Nowy timer"
                  Command="{Binding StartAddTimerCommand}"
                  MinHeight="44" />
          <Button Grid.Column="1" Content="📁 Folder"
                  Command="{Binding CreateFolderCommand}"
                  CommandParameter="{x:Static models:FolderKind.Timers}"
                  MinHeight="44" />
        </Grid>
        <ScrollViewer Grid.Row="1">
          <StackPanel Margin="0,0,0,4" Spacing="8">
            <Border Classes="mud-section"
                    Padding="12"
                    IsVisible="{Binding IsTimerFormExpanded}">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding TimerFormHeader}" Classes="mud-heading" />
                <TextBox Text="{Binding NewTimerName}" PlaceholderText="Nazwa timera" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                  <TextBox Grid.Column="0" Text="{Binding NewTimerMinutes}" PlaceholderText="min" />
                  <TextBox Grid.Column="1" Text="{Binding NewTimerSeconds}" PlaceholderText="s" />
                  <TextBox Grid.Column="2" Text="{Binding NewTimerMilliseconds}" PlaceholderText="ms" />
                </Grid>
                <TextBox Text="{Binding NewTimerCommands}"
                         PlaceholderText="Komendy, każda w osobnej linii"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="90" />
                <CheckBox IsChecked="{Binding NewTimerIsAdvanced}"
                          Content="Zaawansowany — JavaScript" />
                <CheckBox IsChecked="{Binding NewTimerIsGlobal}" Content="Globalny" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <Button Content="{Binding TimerFormButtonText}"
                          Command="{Binding AddTimerCommand}"
                          MinHeight="44" />
                  <Button Grid.Column="1"
                          Content="Anuluj"
                          Command="{Binding CancelTimerEditCommand}"
                          MinHeight="44" />
                </Grid>
              </StackPanel>
            </Border>
            <controls:FolderTreeView Nodes="{Binding TimerTree}"
                                     ItemTemplate="{StaticResource TimerItemTemplate}"
                                     SupportsEnableToggle="True"
                                     MoveIntoFolderCommand="{Binding MoveIntoFolderCommand}"
                                     CreateSubfolderCommand="{Binding CreateSubfolderCommand}"
                                     RenameFolderCommand="{Binding RenameFolderCommand}"
                                     DeleteFolderCommand="{Binding ConfirmDeleteFolderCommand, ElementName=MobileAutomationRoot}"
                                     ToggleFolderGlobalCommand="{Binding ToggleFolderGlobalCommand}"
                                     ToggleFolderEnabledCommand="{Binding ToggleFolderEnabledCommand}" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </TabItem>

    <TabItem Header="Aliasy">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
          <Button Content="＋ Nowy alias"
                  Command="{Binding StartAddAliasCommand}"
                  MinHeight="44" />
          <Button Grid.Column="1" Content="📁 Folder"
                  Command="{Binding CreateFolderCommand}"
                  CommandParameter="{x:Static models:FolderKind.Aliases}"
                  MinHeight="44" />
        </Grid>
        <ScrollViewer Grid.Row="1">
          <StackPanel Margin="0,0,0,4" Spacing="8">
            <Border Classes="mud-section"
                    Padding="12"
                    IsVisible="{Binding IsAliasRuleFormVisible}">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding RuleFormHeader}" Classes="mud-heading" />
                <TextBox Text="{Binding NewRuleName}" PlaceholderText="Nazwa aliasu" />
                <TextBox Text="{Binding NewRulePattern}" PlaceholderText="Wzorzec regex" />
                <TextBlock Text="{Binding NewRulePatternError}"
                           Foreground="{StaticResource MudBrushCrimsonBright}"
                           IsVisible="{Binding HasNewRulePatternError}"
                           TextWrapping="Wrap" />
                <TextBox Text="{Binding NewRuleAction}"
                         PlaceholderText="Komendy"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="90" />
                <CheckBox IsChecked="{Binding NewRuleIsAdvanced}"
                          Content="Zaawansowany — JavaScript" />
                <CheckBox IsChecked="{Binding NewRuleIsGlobal}" Content="Globalny" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <Button Content="{Binding RuleFormButtonText}"
                          Command="{Binding AddRuleCommand}"
                          MinHeight="44" />
                  <Button Grid.Column="1"
                          Content="Anuluj"
                          Command="{Binding CancelRuleEditCommand}"
                          MinHeight="44" />
                </Grid>
              </StackPanel>
            </Border>
            <controls:FolderTreeView Nodes="{Binding AliasTree}"
                                     ItemTemplate="{StaticResource RuleItemTemplate}"
                                     SupportsEnableToggle="True"
                                     MoveIntoFolderCommand="{Binding MoveIntoFolderCommand}"
                                     CreateSubfolderCommand="{Binding CreateSubfolderCommand}"
                                     RenameFolderCommand="{Binding RenameFolderCommand}"
                                     DeleteFolderCommand="{Binding ConfirmDeleteFolderCommand, ElementName=MobileAutomationRoot}"
                                     ToggleFolderGlobalCommand="{Binding ToggleFolderGlobalCommand}"
                                     ToggleFolderEnabledCommand="{Binding ToggleFolderEnabledCommand}" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </TabItem>

    <TabItem Header="Triggery">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
          <Button Content="＋ Nowy trigger"
                  Command="{Binding StartAddTriggerCommand}"
                  MinHeight="44" />
          <Button Grid.Column="1" Content="📁 Folder"
                  Command="{Binding CreateFolderCommand}"
                  CommandParameter="{x:Static models:FolderKind.Triggers}"
                  MinHeight="44" />
        </Grid>
        <ScrollViewer Grid.Row="1">
          <StackPanel Margin="0,0,0,4" Spacing="8">
            <Border Classes="mud-section"
                    Padding="12"
                    IsVisible="{Binding IsTriggerRuleFormVisible}">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding RuleFormHeader}" Classes="mud-heading" />
                <TextBox Text="{Binding NewRuleName}" PlaceholderText="Nazwa triggera" />
                <TextBox Text="{Binding NewRulePattern}" PlaceholderText="Wzorzec regex" />
                <TextBlock Text="{Binding NewRulePatternError}"
                           Foreground="{StaticResource MudBrushCrimsonBright}"
                           IsVisible="{Binding HasNewRulePatternError}"
                           TextWrapping="Wrap" />
                <TextBox Text="{Binding NewRuleAction}"
                         PlaceholderText="Komendy"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="90" />
                <CheckBox IsChecked="{Binding NewRuleIsAdvanced}"
                          Content="Zaawansowany — JavaScript" />
                <CheckBox IsChecked="{Binding NewRuleIsGlobal}" Content="Globalny" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <Button Content="{Binding RuleFormButtonText}"
                          Command="{Binding AddRuleCommand}"
                          MinHeight="44" />
                  <Button Grid.Column="1"
                          Content="Anuluj"
                          Command="{Binding CancelRuleEditCommand}"
                          MinHeight="44" />
                </Grid>
              </StackPanel>
            </Border>
            <controls:FolderTreeView Nodes="{Binding TriggerTree}"
                                     ItemTemplate="{StaticResource RuleItemTemplate}"
                                     SupportsEnableToggle="True"
                                     MoveIntoFolderCommand="{Binding MoveIntoFolderCommand}"
                                     CreateSubfolderCommand="{Binding CreateSubfolderCommand}"
                                     RenameFolderCommand="{Binding RenameFolderCommand}"
                                     DeleteFolderCommand="{Binding ConfirmDeleteFolderCommand, ElementName=MobileAutomationRoot}"
                                     ToggleFolderGlobalCommand="{Binding ToggleFolderGlobalCommand}"
                                     ToggleFolderEnabledCommand="{Binding ToggleFolderEnabledCommand}" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </TabItem>

    <TabItem Header="Skrypty">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
          <Button Content="＋ Nowy skrypt"
                  Command="{Binding StartAddScriptCommand}"
                  MinHeight="44" />
          <Button Grid.Column="1" Content="📁 Folder"
                  Command="{Binding CreateFolderCommand}"
                  CommandParameter="{x:Static models:FolderKind.Scripts}"
                  MinHeight="44" />
        </Grid>
        <ScrollViewer Grid.Row="1">
          <StackPanel Margin="0,0,0,4" Spacing="8">
            <Border Classes="mud-section" Padding="12"
                    IsVisible="{Binding IsScriptFormExpanded}">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding ScriptFormHeader}" Classes="mud-heading" />
                <TextBox Text="{Binding NewScriptName}" PlaceholderText="Nazwa skryptu" />
                <TextBox Text="{Binding NewScriptGmcpPattern}"
                         PlaceholderText="GMCP, np. Char.Vitals (puste = ręcznie)" />
                <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                           Text="onGmcp(), execute(), send(), echo(), reconnect(), variables" />
                <TextBox Text="{Binding NewScriptCode}"
                         PlaceholderText="Kod JavaScript"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         MinHeight="160" />
                <CheckBox IsChecked="{Binding NewScriptIsGlobal}" Content="Globalny" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <Button Content="{Binding ScriptFormButtonText}"
                          Command="{Binding AddScriptCommand}"
                          MinHeight="44" />
                  <Button Grid.Column="1" Content="Anuluj"
                          Command="{Binding CancelScriptEditCommand}"
                          MinHeight="44" />
                </Grid>
              </StackPanel>
            </Border>

            <controls:FolderTreeView Nodes="{Binding ScriptTree}"
                                     ItemTemplate="{StaticResource ScriptItemTemplate}"
                                     SupportsEnableToggle="True"
                                     MoveIntoFolderCommand="{Binding MoveIntoFolderCommand}"
                                     CreateSubfolderCommand="{Binding CreateSubfolderCommand}"
                                     RenameFolderCommand="{Binding RenameFolderCommand}"
                                     DeleteFolderCommand="{Binding ConfirmDeleteFolderCommand, ElementName=MobileAutomationRoot}"
                                     ToggleFolderGlobalCommand="{Binding ToggleFolderGlobalCommand}"
                                     ToggleFolderEnabledCommand="{Binding ToggleFolderEnabledCommand}" />

            <Border Classes="mud-section" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock Text="Zmienne profilu" Classes="mud-heading" />
                <TextBox Text="{Binding NewScriptVariableName}"
                         PlaceholderText="Nazwa, np. combat.target" />
                <TextBox Text="{Binding NewScriptVariableJson}"
                         PlaceholderText="Wartość JSON, np. &quot;ork&quot;" />
                <Button Content="Zapisz zmienną"
                        Command="{Binding AddScriptVariableCommand}" MinHeight="44" />
                <ItemsControl ItemsSource="{Binding ScriptVariables}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ScriptVariableEntry">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,3">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding ValueJson}"
                                   Classes="mud-faint" TextWrapping="Wrap" />
                        <Button Grid.Column="2" Content="✕" Classes="mud-danger"
                                Command="{Binding $parent[UserControl].DataContext.DeleteScriptVariableCommand}"
                                CommandParameter="{Binding}" MinWidth="44" MinHeight="44" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </TabItem>

    <TabItem Header="Drużyna">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="8" Margin="10,8,10,12">
          <TextBlock Classes="mud-heading" Text="Automaty drużynowe" />
          <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                     Text="Automatyczne reakcje na stan drużyny i komunikaty z gry." />

          <Border Classes="mud-section" Padding="10">
            <StackPanel Spacing="10">
              <StackPanel Spacing="3">
                <CheckBox IsChecked="{Binding AutoAssistEnabled}"
                          Content="Autoassist — automatyczne wspieranie drużyny" />
                <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                           Text="Gdy GMCP wykryje, że inny członek drużyny walczy w tym samym pokoju, klient wyśle „as”. Jeśli przestaniesz walczyć, a członek drużyny nadal walczy, komenda zostanie ponowiona." />
                <TextBlock Margin="0,6,0,0"
                           Text="Komendy po asyście" />
                <TextBox MinHeight="64"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         PlaceholderText="Np. wesprzyj;czar 'ochrona'"
                         Text="{Binding AutoAssistFollowUpCommands, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                           Text="Wysyłane po komendzie „as”. Możesz wpisać wiele wierszy lub rozdzielić komendy separatorem ustawionym w opcjach klienta." />
                <TextBlock Margin="0,6,0,0"
                           Text="Moby wykluczone z autoassista" />
                <TextBox MinHeight="64"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         PlaceholderText="Dokładna nazwa moba — po jednej w wierszu"
                         Text="{Binding AutoAssistExcludedMobNamesText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                           Text="Klient nie wyśle „as”, gdy członek grupy w aktualnym pokoju walczy z mobem o jednej z tych nazw. Dopasowanie obejmuje całą nazwę i nie rozróżnia wielkości liter." />
              </StackPanel>

              <StackPanel Spacing="3">
                <CheckBox IsChecked="{Binding GroupOrdersEnabled}"
                          Content="Ordery — wykonuj rozkazy członków drużyny" />
                <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                           Text="Klient wykona komendę z komunikatu „Gracz rozkazuje ci 'komenda'.” tylko wtedy, gdy Gracz znajduje się w aktualnej grupie GMCP." />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</UserControl>

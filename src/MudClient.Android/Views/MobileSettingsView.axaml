<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudClient.App.ViewModels"
             xmlns:models="using:MudClient.App.Models"
             xmlns:services="using:MudClient.App.Services"
             x:Class="MudClient.Android.Views.MobileSettingsView"
             x:DataType="vm:MainWindowViewModel">
  <ScrollViewer>
    <StackPanel Margin="12" Spacing="8">
      <TextBlock Classes="mud-heading" Text="Terminal" />
      <Border Classes="mud-section" Padding="12">
        <StackPanel Spacing="10">
          <StackPanel Spacing="3">
            <TextBlock Classes="mud-label" Text="Czcionka" />
            <ComboBox ItemsSource="{Binding AvailableFonts}"
                      SelectedItem="{Binding OutputFontFamily}"
                      MinHeight="44"
                      MaxDropDownHeight="320">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}"
                             FontFamily="{Binding Converter={x:Static services:AppFontFamilyConverter.Instance}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <CheckBox Content="Zawijaj długie linie"
                    IsChecked="{Binding OutputWordWrap}" />
          <CheckBox Content="Pokazuj liczbowe zakresy statystyk"
                    IsChecked="{Binding ShowNumericCharacterStatRanges}" />
          <CheckBox Content="Pokazuj liczbowe wartości obrażeń"
                    IsChecked="{Binding ShowNumericCombatDamage}" />
          <CheckBox Content="Pogrubiona czcionka"
                    IsChecked="{Binding OutputFontBold}" />

          <StackPanel Spacing="3">
            <TextBlock Classes="mud-label" Text="Schemat kolorów" />
            <ComboBox ItemsSource="{Binding AvailableTelnetColorSchemes}"
                      SelectedItem="{Binding TelnetColorScheme}"
                      MinHeight="44" />
          </StackPanel>

          <StackPanel Spacing="3">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="mud-label" Text="Rozmiar tekstu" />
              <Border Grid.Column="1" Classes="mud-badge mud-badge-gold">
                <TextBlock Text="{Binding OutputFontSizeText}" />
              </Border>
            </Grid>
            <Slider Minimum="{Binding MinOutputFontSize}"
                    Maximum="{Binding MaxOutputFontSize}"
                    Value="{Binding OutputFontSize}"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True" />
          </StackPanel>

          <Button Content="Przywróć domyślne"
                  Command="{Binding ResetOutputFontCommand}"
                  MinHeight="44"
                  HorizontalAlignment="Right" />
        </StackPanel>
      </Border>

      <TextBlock Classes="mud-heading" Text="Komendy" Margin="0,6,0,0" />
      <Border Classes="mud-section" Padding="12">
        <StackPanel Spacing="10">
          <CheckBox Content="Czyść input po wysłaniu"
                    IsChecked="{Binding ClearCommandInputAfterSend}" />
          <StackPanel Spacing="3">
            <TextBlock Classes="mud-label" Text="Separator komend" />
            <TextBox Text="{Binding CommandStackingSeparator}"
                     MaxLength="10"
                     Width="100"
                     MinHeight="44"
                     HorizontalAlignment="Left" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Classes="mud-heading" Text="Mapa" Margin="0,6,0,0" />
      <Border Classes="mud-section" Padding="12">
        <StackPanel Spacing="10">
          <CheckBox Content="Członkowie grupy jako cyfry"
                    IsChecked="{Binding Map.ShowGroupMembersAsNumbers}" />
          <StackPanel Spacing="3">
            <TextBlock Classes="mud-label" Text="Tryb wyświetlania" />
            <ComboBox ItemsSource="{Binding Map.DisplayModes}"
                      SelectedItem="{Binding Map.SelectedDisplayMode}"
                      MinHeight="44" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Classes="mud-heading" Text="Pływające przyciski" Margin="0,6,0,0" />
      <Border Classes="mud-section" Padding="12">
        <StackPanel Spacing="10">
          <StackPanel Spacing="3">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="mud-label"
                         Text="Przezroczystość pada i przycisków" />
              <Border Grid.Column="1" Classes="mud-badge mud-badge-gold">
                <TextBlock Text="{Binding MobileControlsOpacityText}" />
              </Border>
            </Grid>
            <Slider Minimum="{Binding MinMobileControlsOpacity}"
                    Maximum="{Binding MaxMobileControlsOpacity}"
                    Value="{Binding MobileControlsOpacity}"
                    TickFrequency="0.05"
                    IsSnapToTickEnabled="True" />
          </StackPanel>
          <StackPanel Spacing="3">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="mud-label"
                         Text="Rozmiar pływających przycisków" />
              <Border Grid.Column="1" Classes="mud-badge mud-badge-gold">
                <TextBlock Text="{Binding MobileFloatingButtonScaleText}" />
              </Border>
            </Grid>
            <Slider Minimum="{Binding MinMobileButtonScale}"
                    Maximum="{Binding MaxMobileButtonScale}"
                    Value="{Binding MobileFloatingButtonScale}"
                    TickFrequency="0.1"
                    IsSnapToTickEnabled="True" />
          </StackPanel>
          <StackPanel Spacing="3">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="mud-label"
                         Text="Rozmiar przycisków ruchu" />
              <Border Grid.Column="1" Classes="mud-badge mud-badge-gold">
                <TextBlock Text="{Binding MobileMovementButtonScaleText}" />
              </Border>
            </Grid>
            <Slider Minimum="{Binding MinMobileButtonScale}"
                    Maximum="{Binding MaxMobileButtonScale}"
                    Value="{Binding MobileMovementButtonScale}"
                    TickFrequency="0.1"
                    IsSnapToTickEnabled="True" />
          </StackPanel>
          <TextBlock Classes="mud-muted"
                     TextWrapping="Wrap"
                     Text="Każdy schemat ma własne przyciski i ich położenie. Dotknięcie wysyła komendę, a przytrzymanie pozwala przesunąć przycisk." />
          <StackPanel Spacing="3">
            <TextBlock Classes="mud-label" Text="Aktywny schemat" />
            <ComboBox ItemsSource="{Binding FloatingButtonSets}"
                      SelectedItem="{Binding SelectedFloatingButtonSet}"
                      MinHeight="44">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="models:FloatingButtonSetDefinition">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="FloatingButtonSetNameInput"
                     PlaceholderText="Nazwa nowego schematu"
                     MinHeight="44" />
            <Button Grid.Column="1"
                    Content="Utwórz"
                    MinHeight="44"
                    Click="AddFloatingButtonSet_OnClick" />
          </Grid>
          <Button Content="Usuń aktywny schemat"
                  HorizontalAlignment="Right"
                  IsEnabled="{Binding CanDeleteFloatingButtonSet}"
                  Click="DeleteFloatingButtonSet_OnClick" />
          <TextBox x:Name="FloatingButtonNameInput"
                   PlaceholderText="Nazwa przycisku"
                   MaxLength="30"
                   MinHeight="44" />
          <TextBox x:Name="FloatingButtonCommandInput"
                   PlaceholderText="Komenda"
                   MaxLength="300"
                   MinHeight="44" />
          <Button Content="Dodaj pływający przycisk"
                  MinHeight="44"
                  HorizontalAlignment="Right"
                  Click="AddFloatingButton_OnClick" />
          <TextBlock x:Name="FloatingButtonStatusText"
                     Classes="mud-muted"
                     TextWrapping="Wrap"
                     IsVisible="False" />
          <ItemsControl ItemsSource="{Binding FloatingButtons}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:FloatingButtonDefinition">
                <Border Classes="mud-section" Padding="10" Margin="0,3">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Command}"
                                 Classes="mud-muted"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Usuń"
                            Classes="mud-danger"
                            Tag="{Binding}"
                            MinHeight="40"
                            Click="DeleteFloatingButton_OnClick" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <TextBlock Classes="mud-heading" Text="Dane" Margin="0,6,0,0" />
      <Border Classes="mud-section" Padding="12">
        <StackPanel Spacing="10">
          <TextBlock Text="Pełna kopia ustawień"
                     FontWeight="SemiBold" />
          <TextBlock Classes="mud-muted"
                     TextWrapping="Wrap"
                     Text="Eksport obejmuje ustawienia, profile, automaty, timery, autowalk oraz wszystkie schematy pływających przycisków. Hasła przeniesione między Androidem i Windows trzeba wpisać ponownie." />
          <Button x:Name="ExportSettingsButton"
                  Content="Eksportuj pełną kopię ZIP"
                  MinHeight="44"
                  Click="ExportSettings_OnClick" />
          <Button x:Name="SelectImportButton"
                  Content="Wybierz kopię ZIP"
                  MinHeight="44"
                  Click="SelectImport_OnClick" />
          <Button x:Name="ApplyImportButton"
                  Content="Zastosuj import i uruchom ponownie"
                  Classes="mud-danger"
                  MinHeight="44"
                  IsVisible="False"
                  Click="ApplyImport_OnClick" />
          <TextBlock x:Name="ImportStatusText"
                     Classes="mud-muted"
                     TextWrapping="Wrap"
                     IsVisible="False" />
        </StackPanel>
      </Border>
      <TextBlock Classes="mud-heading" Text="Aplikacja" Margin="0,6,0,0" />
      <Border Classes="mud-section" Padding="12">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding AppUpdateStatus}"
                     TextWrapping="Wrap" />
          <ProgressBar IsIndeterminate="True"
                       Height="4"
                       IsVisible="{Binding IsAppUpdateBusy}" />
          <Button Content="Sprawdź aktualizacje"
                  Command="{Binding CheckAppUpdatesCommand}"
                  MinHeight="44" />
          <Button Content="Pobierz i instaluj"
                  Command="{Binding InstallAppUpdateCommand}"
                  MinHeight="44"
                  IsVisible="{Binding IsUpdateAvailable}"
                  IsEnabled="{Binding CanInstallAppUpdate}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MudClient.App.Controls"
        xmlns:views="using:MudClient.App.Views"
        xmlns:vm="using:MudClient.App.ViewModels"
        xmlns:models="using:MudClient.App.Models"
        xmlns:docking="using:MudClient.App.Docking"
        xmlns:dock="using:Dock.Avalonia.Controls"
        x:Class="MudClient.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="RootWindow"
        Icon="/Assets/killer.ico"
        Title="KillerMudClient"
         Width="1400"
         Height="900"
         MinWidth="1024"
         MinHeight="680"
         WindowState="Maximized"
        PointerPressed="Window_OnPointerPressed">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- A single calm command row. Frequent session actions stay visible; account,
         help and layout management live in the overflow menu. -->
    <Border x:Name="MainTopBar" Grid.Row="0" Classes="mud-bar-top">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="⚔"
                     FontSize="16"
                     Foreground="{StaticResource MudBrushGold}"
                     VerticalAlignment="Center" />
          <TextBlock Classes="mud-brand" Text="KillerMudClient" VerticalAlignment="Center" />
          <Border Classes="mud-status-chip" IsVisible="{Binding IsProfileSelected}">
            <TextBlock Text="{Binding ActiveProfileName}"
                       MaxWidth="140"
                       TextTrimming="CharacterEllipsis" />
          </Border>
          <TextBlock Text="{Binding HeaderAreaText}"
                     Classes="mud-caption"
                     MaxWidth="220"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Column="1">
          <Button x:Name="TopKilleropediaButton"
                  Content="Killeropedia"
                  Command="{Binding OpenKilleropediaCommand}"
                  Classes="mud-small"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  ToolTip.Tip="Otwórz Killeropedię" />

          <StackPanel Orientation="Horizontal"
                      Spacing="6"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center">
            <Button x:Name="ApplicationUpdateButton"
                  Classes="mud-notice"
                  Content="Nowa wersja"
                  IsVisible="{Binding IsUpdateAvailable}">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <StackPanel Spacing="8" Width="320">
                    <TextBlock Classes="mud-section-title"
                               Text="Aktualizacja aplikacji" />
                    <TextBlock Text="{Binding UpdateNotificationText}"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                      <Button Content="Aktualizuj"
                              Command="{Binding InstallAppUpdateCommand}"
                              IsVisible="{Binding CanInstallAppUpdate}"
                              Classes="mud-small" />
                      <Button Content="Pobierz"
                              Command="{Binding OpenUpdateReleaseCommand}"
                              IsVisible="{Binding !CanInstallAppUpdate}"
                              Classes="mud-small" />
                      <Button Content="Lista zmian"
                              Command="{Binding OpenChangelogCommand}"
                              Classes="mud-small" />
                      <Button Content="Ukryj"
                              Command="{Binding DismissUpdateCommand}"
                              Classes="mud-small" />
                    </StackPanel>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>

            <Button x:Name="ContentUpdateButton"
                    Classes="mud-notice mud-notice-success"
                    Content="Nowe dane"
                    IsVisible="{Binding IsContentUpdateAvailable}">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <StackPanel Spacing="8" Width="340">
                    <TextBlock Classes="mud-section-title"
                               Text="Aktualizacja danych gry" />
                    <TextBlock Text="{Binding ContentUpdateDescription}"
                               TextWrapping="Wrap" />
                    <Button Content="Aktualizuj"
                            Command="{Binding InstallContentUpdateCommand}"
                            Classes="mud-small"
                            HorizontalAlignment="Right" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Grid>

        <StackPanel x:Name="ConnectionActions"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="7"
                    VerticalAlignment="Center">
          <Border x:Name="IdleTimeBadge"
                  Classes="mud-status-chip"
                  MinWidth="86"
                  ToolTip.Tip="Czas od ostatniej komendy wysłanej do MUD-a">
            <TextBlock x:Name="IdleTimeIndicator"
                       Text="{Binding IdleTimeText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{Binding StatusText}"
                     Classes="mud-connection-status"
                     VerticalAlignment="Center"
                     MaxWidth="120"
                     TextTrimming="CharacterEllipsis" />
          <Button Content="Połącz"
                  Command="{Binding ConnectCommand}"
                  IsVisible="{Binding !IsConnected}"
                  Classes="mud-small" />
          <Button Classes="mud-danger mud-small"
                  Content="Rozłącz"
                  Command="{Binding DisconnectCommand}"
                  IsVisible="{Binding IsConnected}" />
          <Button x:Name="MoreActionsButton"
                  Content="Więcej  ⋯"
                  Classes="mud-small"
                  ToolTip.Tip="Konto, narzędzia i układ">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Spacing="4" MinWidth="220">
                  <Button Content="Zmień konto"
                          Command="{Binding SwitchProfileCommand}"
                          HorizontalContentAlignment="Left"
                          Classes="mud-menu-action"
                          ToolTip.Tip="Przełączanie konta jest możliwe po rozłączeniu sesji." />
                  <Button Content="Discord"
                          Command="{Binding OpenDiscordCommand}"
                          HorizontalContentAlignment="Left"
                          Classes="mud-menu-action" />
                  <Button Content="Pomoc"
                          Command="{Binding OpenHelpCommand}"
                          HorizontalContentAlignment="Left"
                          Classes="mud-menu-action" />
                  <Separator Margin="0,3" />
                  <Button Content="{Binding HiddenPanels.Count, StringFormat='Przywróć panele ({0})'}"
                          IsVisible="{Binding HiddenPanels.Count}"
                          HorizontalContentAlignment="Left"
                          Classes="mud-menu-action">
                    <Button.Flyout>
                      <Flyout Placement="LeftEdgeAlignedTop">
                        <ItemsControl ItemsSource="{Binding HiddenPanels}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="docking:PanelTool">
                              <Button Content="{Binding Title}"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Left"
                                      Classes="mud-menu-action"
                                      Command="{Binding $parent[Window].DataContext.RestorePanelCommand}"
                                      CommandParameter="{Binding}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                  <Button x:Name="LayoutMenuButton"
                          Content="Układy paneli"
                          HorizontalContentAlignment="Left"
                          Classes="mud-menu-action">
                    <Button.Flyout>
                      <Flyout Placement="LeftEdgeAlignedTop">
                        <StackPanel Spacing="6" MinWidth="220">
                          <TextBlock Classes="mud-section-title" Text="Wczytaj układ" />
                          <ItemsControl ItemsSource="{Binding AvailableLayouts}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="models:LayoutMenuItem">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                  <Button Grid.Column="0"
                                          Content="{Binding Name}"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Left"
                                          Classes="mud-menu-action"
                                          Command="{Binding $parent[Window].DataContext.ApplyLayoutCommand}"
                                          CommandParameter="{Binding Name}" />
                                  <Button Grid.Column="1"
                                          Classes="mud-danger mud-small"
                                          Content="✕"
                                          Margin="4,0,0,0"
                                          ToolTip.Tip="Usuń układ"
                                          IsVisible="{Binding CanDelete}"
                                          Command="{Binding $parent[Window].DataContext.DeleteLayoutCommand}"
                                          CommandParameter="{Binding Name}" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Separator Margin="0,3" />
                          <TextBlock Classes="mud-section-title" Text="Zapisz obecny układ" />
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBox Grid.Column="0"
                                     Text="{Binding NewLayoutName}"
                                     PlaceholderText="Nazwa układu" />
                            <Button Grid.Column="1"
                                    Content="Zapisz"
                                    Classes="mud-small"
                                    Command="{Binding SaveLayoutCommand}" />
                          </Grid>
                        </StackPanel>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

     <!-- ========================================================================
         Row 1: Main content – 25* (left), 50* (terminal), 25* (right)
         ======================================================================== -->
    <dock:DockControl x:Name="MainDock" Grid.Row="1" Layout="{Binding Layout}" Margin="8" />

    <controls:FloatingButtonsOverlay Grid.Row="1" Margin="8" />

    <!-- Transient messages float above the workspace instead of increasing header height. -->
    <StackPanel Grid.Row="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,8,18,0"
                Spacing="5"
                Panel.ZIndex="100">
      <ItemsControl ItemsSource="{Binding Toasts}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="5" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:ToastMessage">
            <Border Classes="mud-toast"
                    IsVisible="{Binding IsVisible}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Text="{Binding IconGlyph}"
                           Foreground="{Binding ForegroundBrush}" />
                <TextBlock Text="{Binding Text}"
                           MaxWidth="300"
                           ToolTip.Tip="{Binding Text}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Classes="mud-small"
              Content="Wyczyść"
              Command="{Binding ClearToastsCommand}"
              HorizontalAlignment="Right"
              IsVisible="{Binding Toasts.Count}" />
    </StackPanel>

    <!-- ========================================================================
         Row 2: Footer bar
         ======================================================================== -->
    <Border Grid.Row="2" Classes="mud-bar-bottom" Padding="10,5">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
        <TextBlock Classes="mud-faint" Text="Telnet + ANSI + GMCP  •  KillerMudClient" />
        <TextBlock Classes="mud-faint" Text="{Binding Vitals.Name, StringFormat='Postać: {0}'}" />
        <TextBlock Classes="mud-faint" Text="{Binding StatusText}" />
      </Grid>
    </Border>

    <controls:LargeTabbedWidget Grid.RowSpan="3"
                                Title="Killeropedia"
                                IsBookStyle="True"
                                IsOpen="{Binding IsKilleropediaOpen}">
      <controls:LargeTabbedWidget.TabContent>
        <TabControl Classes="mud-large-widget-tabs killeropedia-book-tabs">
          <TabItem Classes="killeropedia-tab-teachers" Header="Nauczyciele">
            <views:KilleropediaTeachersView
                                            DataContext="{Binding Killeropedia}" />
          </TabItem>
          <TabItem Classes="killeropedia-tab-books" Header="Księgi Magiczne">
            <views:KilleropediaBooksView
                                         DataContext="{Binding Killeropedia}" />
          </TabItem>
          <TabItem Classes="killeropedia-tab-lore" Header="Świat i lore">
            <views:KilleropediaLoreView
                                        DataContext="{Binding Killeropedia}" />
          </TabItem>
          <TabItem Classes="killeropedia-tab-quests" Header="Zadania">
            <views:KilleropediaQuestsView
                                        DataContext="{Binding Killeropedia}" />
          </TabItem>
          <TabItem Classes="killeropedia-tab-map" Header="Mapa Świata">
            <views:KilleropediaWorldMapView
                                            DataContext="{Binding Killeropedia}" />
          </TabItem>
        </TabControl>
      </controls:LargeTabbedWidget.TabContent>
    </controls:LargeTabbedWidget>

    <controls:LargeTabbedWidget Grid.RowSpan="3"
                                Title="Pomoc"
                                IsOpen="{Binding IsHelpOpen}">
      <controls:LargeTabbedWidget.TabContent>
        <TabControl Classes="mud-large-widget-tabs">
          <TabItem Header="Dostępne komendy">
            <ScrollViewer Margin="0,12,0,0">
              <StackPanel Spacing="10" MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock Classes="mud-muted"
                           Text="Komendy klienta wpisuj w polu komendy terminala. Wielkość liter nie ma znaczenia."
                           TextWrapping="Wrap" />

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="150,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="/idz" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="Rozpoczyna marsz do celu wybranego dwuklikiem na mapie albo wznawia przerwaną podróż." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="150,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="/idz &lt;cel&gt;" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="Rozpoczyna marsz do członka grupy widocznego przez GMCP albo do zapisanej lokacji o podanej nazwie." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="180,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="/idz vnum &lt;vnum&gt;" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="Rozpoczyna marsz do pokoju o podanym numerze VNUM." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="180,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="/idz smierc" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="Rozpoczyna marsz do ostatniego zapisanego miejsca śmierci aktywnego profilu." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="180,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="/idz_dodaj &lt;nazwa&gt;" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="Zapisuje obecną lokację pod podaną nazwą dla aktywnego konta." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="150,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="/stop" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="Zatrzymuje trwający autowalk." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="150,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="/recast [nazwa zestawu]" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="Ponownie rzuca wszystkie brakujące czary z aktywnego zestawu buffów. Podanie nazwy rzuca brakujące czary z wybranego zestawu bez przełączania go, np. /recast smok." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="150,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="/reroll" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="Zatrzymuje automatyczne rolowanie statystyk postaci i ponownie otwiera konfigurację wartości docelowych." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="180,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="/script &lt;nazwa&gt;" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="Uruchamia aktywny skrypt o podanej nazwie. Skrypt może wywoływać aliasy, komendy klienta i komendy MUD-a." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="220,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="/map &lt;komenda&gt;" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="W trybie lorda steruje edytorem mapy. Pełna lista komend mapowania znajduje się poniżej. Można też używać prefiksów /mapa i +map." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="220,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="/map show &lt;vnum&gt;" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="Wyszukuje pokój o podanym VNUM-ie, ustawia go jako cel mapy i otwiera widok mapy. Użyj tej komendy, aby szybko przejść do konkretnego pokoju." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="220,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="Komendy mapowania" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="start / stop — rozpoczęcie i zakończenie mapowania; save — zapis zmian; undo / redo — cofanie i ponawianie; cancel — odrzucenie bieżącej sesji; status lub info — stan i informacje o pokoju; check / diff — kontrola i porównanie map; import / export — wymiana mapy z plikiem; discard — odrzucenie mapy roboczej; resolve keep|gmcp — rozwiązanie konfliktu; step &lt;1-20&gt; — krok mapowania; area / reassign — praca z krainą; room — informacje o pokoju; symbol — symbol pokoju; label — etykieta; forget — usunięcie pokoju; special — przejście specjalne." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="220,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="alias(...) w triggerze/timerze" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="W prostym triggerze albo timerze wpisz alias(nazwa-aliasu) lub alias(tekst-dopasowany-do-wzorca). Klient uruchomi istniejący alias i wyśle jego rozwinięcie, także wiele komend rozdzielonych nowymi liniami lub separatorem. Przykład: alias(buff)." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="220,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="echo(&quot;kolor&quot;, &quot;tekst&quot;)" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="W prostych automatach wyświetla lokalny tekst bez wysyłania go do MUD-a. Kolory: black, red, green, yellow, blue, magenta, cyan, white, gray. Przykład: echo(&quot;red&quot;, &quot;Straciłeś ochronę!&quot;). W JavaScript kolejność argumentów jest odwrotna: echo(tekst, kolor)." />
                  </Grid>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Skryptowanie">
            <ScrollViewer Margin="0,12,0,0">
              <StackPanel Spacing="10" MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock Classes="mud-muted"
                           TextWrapping="Wrap"
                           Text="Aliasy, triggery i timery mogą działać w trybie prostym albo zaawansowanym. Tryb zaawansowany wykonuje JavaScript. Samodzielne skrypty znajdziesz w zakładce Skrypty panelu Automatów." />

                <Border Classes="mud-section" Padding="14">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Kiedy używać którego trybu?"
                               FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock TextWrapping="Wrap"
                               Text="Tryb prosty wystarcza do rozwijania wzorca na komendy, alias(...), echo(...) i podstawiania zmiennych przez ${nazwa}. Tryb zaawansowany wybierz, gdy potrzebujesz if, pętli, obliczeń, danych z dopasowania lub kilku zależnych akcji." />
                  </StackPanel>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="190,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="execute(tekst)" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="Wykonuje tekst pełną ścieżką klienta. Obsługuje aliasy, separator komend oraz komendy wbudowane, np. /idz, /recast, /map i /script." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="190,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="runAlias(tekst)" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="Uruchamia tekst jak komendę wpisaną przez użytkownika. Może wskazywać nazwę lub tekst pasujący do istniejącego aliasu." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="190,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="send(tekst)" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="Wysyła tekst bezpośrednio do MUD-a. Nie rozwija aliasów i nie wykonuje komend klienta. Respektuje skonfigurowany separator komend." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="190,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="echo(tekst, kolor)" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="Wyświetla lokalny komunikat w terminalu. Kolor jest opcjonalny i domyślnie ma wartość cyan." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="190,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="reconnect()" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="Rozłącza klienta i ponownie łączy z MUD-em przy użyciu obecnego profilu, łącznie z automatycznym logowaniem. Działa w zaawansowanych aliasach, triggerach, timerach i skryptach." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="190,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="deleteLine()" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <StackPanel Grid.Column="1" Spacing="7">
                      <TextBlock TextWrapping="Wrap"
                                 Text="Ukrywa w terminalu bieżącą linię dopasowaną przez zaawansowany trigger. Wywołanie poza obsługą linii triggera nie zmienia terminala." />
                      <TextBlock FontFamily="Consolas" TextWrapping="Wrap"
                                 Text="// Trigger: ^Nie masz wystarczająco many\.$&#10;if (match) {&#10;  deleteLine();&#10;}" />
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="190,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="commandHistory(limit = 10)" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <StackPanel Grid.Column="1" Spacing="7">
                      <TextBlock TextWrapping="Wrap"
                                 Text="Zwraca tablicę komend wpisanych w terminalu, od najnowszej. Historia obejmuje bieżącą sesję i przechowuje najwyżej 100 oryginalnych wpisów; komendy wysłane przez automatyzację nie są do niej dodawane." />
                      <TextBlock FontFamily="Consolas" TextWrapping="Wrap"
                                 Text="const recent = commandHistory(10);&#10;recent.forEach((command, index) =&gt; {&#10;  console.log(`${index + 1}.`, command);&#10;});" />
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <StackPanel Spacing="7">
                    <TextBlock Text="await http.get/post/put/patch/delete"
                               FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock TextWrapping="Wrap"
                               Text="Wykonuje asynchroniczny request HTTP lub HTTPS. Dostępne są http.get(url, opcje), http.post(url, body, opcje), http.put(...), http.patch(...), http.delete(url, opcje) oraz http.request(url, { method, headers, body, timeoutMs })." />
                    <TextBlock FontFamily="Consolas"
                               TextWrapping="Wrap"
                               Text="const response = await http.get(&quot;https://example.com/api&quot;);&#10;if (response.ok) {&#10;  const data = response.json();&#10;  console.log(data);&#10;}" />
                    <TextBlock TextWrapping="Wrap"
                               Text="Odpowiedź zawiera status, ok, reason, url, headers, text oraz json(). Obiekt lub tablica przekazane jako body są kodowane do JSON. Błędy requestu można obsłużyć przez try/catch." />
                  </StackPanel>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Konsola JavaScript"
                               FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock TextWrapping="Wrap"
                               Text="log(...wartości), console.log(...), console.warn(...) i console.error(...) zapisują wpisy w osobnym widżecie Konsola JavaScript. Konsola przechowuje 500 ostatnich wpisów wraz z godziną, poziomem i nazwą źródłowego automatu. Widżety Konsola JavaScript i Zmienne są domyślnie ukryte; przywrócisz je przez Więcej → Przywróć panele." />
                  </StackPanel>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="190,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="input i match" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="input zawiera wejściową komendę lub linię. W aliasie i triggerze match.value zawiera całe dopasowanie, match.captures grupy numerowane, a match.groups grupy nazwane." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Zmienne profilu"
                               FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock TextWrapping="Wrap"
                               Text="variables.get(nazwa, wartośćDomyślna), set(nazwa, wartość), has(nazwa), remove(nazwa) i increment(nazwa, ilość) korzystają ze wspólnego magazynu aktywnego profilu. Wartości są zapisywane jako JSON i pozostają dostępne dla innych aliasów, triggerów, timerów oraz skryptów." />
                  </StackPanel>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <StackPanel Spacing="6">
                    <TextBlock Text="GMCP"
                               FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock TextWrapping="Wrap"
                               Text="Skrypt może odbierać każdy przychodzący pakiet GMCP, również taki, którego klient sam nie interpretuje. W konfiguracji skryptu ustaw filtr dokładny, np. Char.Vitals, filtr prefiksu Char.* albo * dla wszystkich pakietów. Pusty filtr oznacza wywołanie wyłącznie ręczne." />
                    <TextBlock TextWrapping="Wrap"
                               Text="W obsłudze GMCP event.package zawiera nazwę pakietu, event.data jego sparsowany JSON, a event.raw surowy tekst JSON. event.data może być obiektem, tablicą albo null. Funkcja onGmcp(wzorzec, handler) uruchamia handler tylko dla pasującego pakietu." />
                  </StackPanel>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <StackPanel Spacing="7">
                    <TextBlock Text="Najczęstsze pakiety KillerMUD"
                               FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock TextWrapping="Wrap"
                               Text="Char.Vitals — HP, MV, pamięć, poziom i pozycja postaci.&#10;Char.Condition — głód, pragnienie, stan i pozycja.&#10;Char.Affects — tablica aktywnych efektów, m.in. name, negative, ending i extraValue.&#10;Char.Group — lider oraz tablica members z członkami drużyny.&#10;Char.MemSpell — tablica zapamiętanych i zapamiętywanych czarów.&#10;Room.Info — dane pokoju, VNUM i wyjścia.&#10;Room.People — tablica postaci i NPC w pokoju." />
                    <TextBlock Classes="mud-muted"
                               TextWrapping="Wrap"
                               Text="Dokładny zestaw pól zależy od serwera. Aktualne komunikaty można podejrzeć w panelu GMCP odebrane." />
                  </StackPanel>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Rozpoznawanie pakietów i ich struktury"
                               FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock TextWrapping="Wrap"
                               Text="Ustaw filtr GMCP skryptu na *, a następnie wypisz nazwę pakietu i jego dane w Konsoli JavaScript:" />
                    <TextBlock FontFamily="Consolas"
                               TextWrapping="Wrap"
                               Text="onGmcp(&quot;*&quot;, event =&gt; {&#10;  console.log(event.package, JSON.stringify(event.data));&#10;});" />
                  </StackPanel>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Zapamiętywanie ostatnich danych GMCP"
                               FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock TextWrapping="Wrap"
                               Text="GMCP jest zdarzeniem, więc poza jego obsługą nie ma synchronicznego getGmcp(). Dane potrzebne później zapisz w trwałych zmiennych profilu:" />
                    <TextBlock FontFamily="Consolas"
                               TextWrapping="Wrap"
                               Text="onGmcp(&quot;Char.Vitals&quot;, event =&gt; {&#10;  variables.set(&quot;gmcp.vitals&quot;, event.data);&#10;});&#10;&#10;const vitals = variables.get(&quot;gmcp.vitals&quot;, {});" />
                  </StackPanel>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Przykład: reakcja na niski poziom HP"
                               FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock FontFamily="Consolas"
                               TextWrapping="Wrap"
                               Text="onGmcp(&quot;Char.Vitals&quot;, event =&gt; {&#10;  variables.set(&quot;hp&quot;, event.data.hp);&#10;  if (event.data.hp &lt; 25) {&#10;    echo(&quot;Mało HP!&quot;, &quot;red&quot;);&#10;    execute(&quot;/idz lecznica&quot;);&#10;  }&#10;});" />
                  </StackPanel>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Bezpieczeństwo i błędy"
                               FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock TextWrapping="Wrap"
                               Text="Skrypty nie mają dostępu do CLR, plików ani strumienia MUD-a. HTTP działa wyłącznie przez ograniczone API dla publicznych adresów HTTP/HTTPS: bez localhosta i sieci prywatnych, najwyżej 5 requestów na wykonanie, 5 przekierowań, 256 KiB requestu, 1 MiB odpowiedzi i 30 s na request. Skrypt może wysłać do wskazanego serwera dane, które jawnie przekażesz w URL, nagłówkach lub body. Interpreter ogranicza też czas całego wykonania, pamięć, liczbę instrukcji, rekurencję i liczbę akcji. Błąd jest wyświetlany przy konkretnym automacie i zapisywany w Konsoli JavaScript; rozłączenie anuluje oczekujące wykonania." />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </controls:LargeTabbedWidget.TabContent>
    </controls:LargeTabbedWidget>

    <!-- Profile picker overlay (shown until a profile is chosen) -->
    <Grid Grid.RowSpan="3"
          IsVisible="{Binding !IsProfileSelected}"
          Background="#B0080A0B">
      <Border HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="520"
              Classes="mud-panel"
              BorderBrush="{StaticResource MudBrushGoldBright}"
              BorderThickness="1"
              Padding="24">
        <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="10">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <TextBlock Grid.Column="0" Text="⚔" FontSize="28" Foreground="{StaticResource MudBrushGoldBright}" />
            <StackPanel Grid.Column="1">
              <TextBlock Classes="mud-heading-lg" Text="Wybierz profil" />
              <TextBlock Classes="mud-muted"
                         TextWrapping="Wrap"
                         Text="Profil przechowuje hasło, notatki, automaty, skrypty i ich wspólne zmienne." />
            </StackPanel>
          </Grid>

          <TextBlock Classes="mud-faint"
                     TextWrapping="Wrap"
                     Text="Dwuklik na profilu łączy od razu."
                     IsVisible="{Binding HasProfiles}" />

          <ListBox x:Name="ProfileListBox"
                   ItemsSource="{Binding AvailableProfiles}"
                   SelectedItem="{Binding SelectedProfileName}"
                   MaxHeight="120"
                   Background="Transparent"
                   IsVisible="{Binding HasProfiles}"
                   DoubleTapped="ProfileList_OnDoubleTapped">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="CornerRadius" Value="6" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                      ColumnSpacing="8"
                      DragDrop.AllowDrop="True"
                      PointerPressed="ProfileItem_OnPointerPressed"
                      PointerMoved="ProfileItem_OnPointerMoved"
                      DragDrop.DragOver="ProfileItem_OnDragOver"
                      DragDrop.Drop="ProfileItem_OnDrop">
                  <TextBlock Grid.Column="0"
                             Text="⠿"
                             FontSize="16"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource MudBrushParchmentFaint}"
                             ToolTip.Tip="Przeciągnij, aby zmienić kolejność profili" />
                  <TextBlock Grid.Column="1"
                             Text="🛡"
                             FontSize="16"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource MudBrushGoldBright}" />
                  <TextBlock Grid.Column="2"
                             Text="{Binding}"
                             FontSize="14"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                  <Button Grid.Column="3"
                          Content="🗑"
                          FontSize="12"
                          Padding="6,2"
                          VerticalAlignment="Center"
                          Click="DeleteProfile_OnClick"
                          ToolTip.Tip="Usuń konto (bezpowrotnie kasuje plik konta)" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Classes="mud-faint"
                     TextWrapping="Wrap"
                     Text="Brak zapisanych profili — utwórz pierwszy poniżej."
                     IsVisible="{Binding !HasProfiles}" />

          <StackPanel IsVisible="{Binding !IsCopyProfileEditorOpen}"
                      Spacing="10">
          <StackPanel x:Name="ProfileServerFields"
                      Spacing="6"
                      IsVisible="{Binding HasProfiles}">
            <TextBlock Text="Ustawienia wybranego profilu"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource MudBrushParchmentDim}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Text="Nazwa profilu"
                           Classes="mud-faint" />
                <TextBox x:Name="SelectedProfileNameInput"
                         Text="{Binding SelectedProfileDisplayName}"
                         PlaceholderText="Lokalna nazwa profilu"
                         KeyDown="SelectProfileField_OnKeyDown" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="Login MUD"
                           Classes="mud-faint" />
                <TextBox x:Name="SelectedProfileLoginInput"
                         Text="{Binding SelectedProfileLogin}"
                         PlaceholderText="Login wysyłany do MUD-a"
                         KeyDown="SelectProfileField_OnKeyDown" />
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding SelectedProfileNameValidationMessage}"
                       Foreground="#FFE57373"
                       FontSize="11"
                       IsVisible="{Binding SelectedProfileNameValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Grid ColumnDefinitions="*,110" ColumnSpacing="8">
              <TextBox Grid.Column="0"
                       Text="{Binding Host}"
                       PlaceholderText="host"
                       KeyDown="SelectProfileField_OnKeyDown"
                       ToolTip.Tip="Adres serwera MUD dla wybranego konta" />
              <TextBox Grid.Column="1"
                       Text="{Binding Port}"
                       PlaceholderText="port"
                       KeyDown="SelectProfileField_OnKeyDown"
                       ToolTip.Tip="Port serwera dla wybranego konta (1–65535)" />
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <TextBox Grid.Column="0"
                       Text="{Binding SelectedProfilePassword}"
                       PasswordChar="●"
                       PlaceholderText="Nowe hasło (opcjonalnie)"
                       KeyDown="SelectProfileField_OnKeyDown"
                       ToolTip.Tip="Puste pole zachowuje zapisane hasło. Hasło jest szyfrowane na dysku." />
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding AvailableEncodings}"
                        SelectedItem="{Binding Encoding}"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="Kodowanie tekstu dla wybranego konta (Auto wykrywa UTF-8 lub Windows-1250 automatycznie)" />
            </Grid>
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasProfiles}">
            <Button Grid.Column="0"
                    Content="Wybierz profil"
                    Command="{Binding SelectProfileCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="16,7" />
            <Button Grid.Column="1"
                    Content="Kopiuj"
                    Command="{Binding StartCopyProfileCommand}"
                    Padding="16,7"
                    ToolTip.Tip="Skopiuj wszystkie ustawienia wybranego profilu" />
          </Grid>
          </StackPanel>

          <Border IsVisible="{Binding IsCopyProfileEditorOpen}"
                  BorderBrush="{StaticResource MudBrushSlate}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="10">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding CopyProfileSourceName, StringFormat='Kopia konta „{0}”'}"
                         FontWeight="SemiBold" />
              <TextBlock Classes="mud-faint"
                         TextWrapping="Wrap"
                         Text="Wszystkie ustawienia zostaną skopiowane. Zmień tylko nazwę profilu, konto MUD i hasło." />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <TextBox Grid.Column="0"
                         Text="{Binding CopyProfileName}"
                         PlaceholderText="Nowa nazwa profilu" />
                <TextBox Grid.Column="1"
                         Text="{Binding CopyProfileLogin}"
                         PlaceholderText="Nowe konto MUD" />
              </Grid>
              <TextBox Text="{Binding CopyProfilePassword}"
                       PasswordChar="●"
                       PlaceholderText="Nowe hasło" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0"
                        Content="Anuluj"
                        Command="{Binding CancelCopyProfileCommand}" />
                <Button Grid.Column="1"
                        Content="Utwórz kopię"
                        Command="{Binding CopyProfileCommand}" />
              </Grid>
            </StackPanel>
          </Border>

          <StackPanel IsVisible="{Binding !IsCopyProfileEditorOpen}"
                      Spacing="10">
          <Separator />

          <TextBlock Classes="mud-faint"
                     TextWrapping="Wrap"
                     Text="Nowy profil — jego lokalna nazwa może być inna niż login wysyłany do MUD-a." />

          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <TextBox Grid.Column="0"
                     Text="{Binding NewProfileName}"
                     PlaceholderText="Nazwa profilu"
                     KeyDown="CreateProfileField_OnKeyDown" />
            <TextBox Grid.Column="1"
                     Text="{Binding NewProfileLogin}"
                     PlaceholderText="Login MUD"
                     KeyDown="CreateProfileField_OnKeyDown"
                     ToolTip.Tip="Puste pole użyje nazwy konta jako loginu." />
          </Grid>

          <Grid x:Name="NewProfileServerFields" ColumnDefinitions="*,110" ColumnSpacing="8">
            <TextBox Grid.Column="0"
                     Text="{Binding NewProfileHost}"
                     PlaceholderText="host"
                     KeyDown="CreateProfileField_OnKeyDown"
                     ToolTip.Tip="Adres serwera MUD dla nowego konta" />
            <TextBox Grid.Column="1"
                     Text="{Binding NewProfilePort}"
                     PlaceholderText="port"
                     KeyDown="CreateProfileField_OnKeyDown"
                     ToolTip.Tip="Port serwera dla nowego konta (1–65535)" />
          </Grid>

          <ComboBox ItemsSource="{Binding AvailableEncodings}"
                    SelectedItem="{Binding NewProfileEncoding}"
                    HorizontalAlignment="Stretch"
                    ToolTip.Tip="Kodowanie tekstu dla nowego konta (Auto wykrywa UTF-8 lub Windows-1250 automatycznie)" />

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0"
                     Text="{Binding NewProfilePassword}"
                     PasswordChar="●"
                     PlaceholderText="Hasło (zapisywane zaszyfrowane)"
                     KeyDown="CreateProfileField_OnKeyDown" />
            <Button Grid.Column="1"
                    Content="Utwórz"
                    Command="{Binding CreateProfileCommand}"
                    Padding="16,7" />
          </Grid>
          </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Startup / fatal error overlay -->
    <Grid Grid.RowSpan="3"
          IsVisible="{Binding HasStartupError}"
          Background="#B0080A0B">
      <Border HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="620"
              MaxWidth="900"
              Classes="mud-panel"
              BorderBrush="{StaticResource MudBrushCrimson}"
              BorderThickness="1"
              Padding="24">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="☠" FontSize="28" Foreground="{StaticResource MudBrushCrimsonBright}" />
            <StackPanel>
              <TextBlock Classes="mud-heading-lg" Text="Błąd uruchamiania" />
              <TextBlock Classes="mud-muted"
                         Text="Aplikacja napotkała problem przy inicjalizacji widoku." />
            </StackPanel>
          </StackPanel>

          <TextBlock Text="{Binding StartupErrorMessage}"
                     FontSize="16"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />

          <Border Classes="mud-section" Background="{StaticResource MudBrushVoid}" Padding="12">
            <TextBlock Text="{Binding StartupErrorDetails}"
                       Classes="mud-faint"
                       TextWrapping="Wrap" />
          </Border>

          <TextBlock Classes="mud-faint"
                     Text="Możesz spróbować ponownie albo zamknąć aplikację i uruchomić ją jeszcze raz." />

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Ponów" Command="{Binding RetryStartupCommand}" Padding="16,7" />
            <Button Content="Zamknij" Classes="mud-danger" Click="Close_OnClick" Padding="16,7" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

  </Grid>
</Window>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MudClient.App.Controls"
             xmlns:vm="using:MudClient.App.ViewModels"
             x:Class="MudClient.App.Views.Panels.ChatPanelView"
             x:DataType="vm:MainWindowViewModel">
  <!--
    A mini-console mirroring every communication line (say/sayto/tell/clantell/grouptell/yell/
    shout — see MudClient.Core.Automation.ChatLinePolicy) alongside the main terminal, so it can
    be read, scrolled, and copied independently of the terminal's own scrollback. Reuses
    MudOutputView (the same colored-scrollback control the terminal uses) rather than a plain
    list, so ANSI coloring, scrollback, and text selection/copy all come for free.
  -->
  <controls:MudOutputView x:Name="ChatOutput"
                          OutputFontFamily="{Binding OutputFontFamilyValue}"
                          OutputFontSize="{Binding OutputFontSize}"
                          OutputFontWeight="{Binding OutputFontWeight}"
                          TelnetColorScheme="{Binding TelnetColorScheme}"
                          WordWrap="{Binding OutputWordWrap}" />
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudClient.App.ViewModels"
             xmlns:models="using:MudClient.App.Models"
             xmlns:local="using:MudClient.App.Views.Panels"
             x:Class="MudClient.App.Views.Panels.RoomInfoPanelView"
             x:DataType="vm:MainWindowViewModel"
             x:Name="RoomInfoRoot">
  <ScrollViewer>
    <StackPanel Spacing="12" Margin="12">
      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding $parent[local:RoomInfoPanelView].ShowDetails}">
        <!-- Left: details -->
        <StackPanel Grid.Column="0" Spacing="8">
        <Border Background="{StaticResource MudBrushVoid}"
                CornerRadius="3" Padding="8">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Classes="mud-muted" Text="Id:" />
              <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding Map.SelectedRoom.Id}" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Classes="mud-muted" Text="Nazwa:" />
              <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                         Text="{Binding Map.SelectedRoom.Name}"
                         TextTrimming="CharacterEllipsis" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Classes="mud-muted" Text="Vnum:" />
              <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding Map.SelectedRoom.Vnum}" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Classes="mud-muted" Text="Sektor:" />
              <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding Map.SelectedRoom.Sector}" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Classes="mud-muted" Text="Środowisko:" />
              <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                         Text="{Binding Map.SelectedRoom.Environment}"
                         TextTrimming="CharacterEllipsis" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Classes="mud-muted" Text="Waga:" />
              <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding Map.SelectedRoom.Weight}" />
            </Grid>
          </StackPanel>
        </Border>
        </StackPanel>

        <!-- Right: square room image -->
        <Border Grid.Column="1"
                Background="{StaticResource MudBrushVoid}"
                BorderBrush="{StaticResource MudBrushGoldDim}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="6"
                Margin="12,0,0,0"
                Width="170"
                Height="170"
                VerticalAlignment="Top">
          <Image Source="{Binding Map.SelectedRoomIcon}"
                 Stretch="Uniform"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center" />
        </Border>
      </Grid>

      <StackPanel Spacing="6">
        <TextBlock Classes="mud-heading" Text="Osoby w pokoju" />
        <TextBlock Classes="mud-faint" Text="Nikogo tu nie ma."
                   IsVisible="{Binding !People.Count}" />
        <!-- Desktop list view -->
        <ItemsControl ItemsSource="{Binding People}" IsVisible="{Binding IsDesktopView}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:PersonEntry">
              <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Margin="0,1">
                <TextBlock Grid.Column="0" Text="•" Classes="mud-muted" Margin="0,0,6,0" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                            IsVisible="{Binding !IsSelf}">
                  <Button Content="exa" Classes="mud-small" Padding="6,1"
                          Command="{Binding #RoomInfoRoot.DataContext.ExaminePersonCommand}"
                          CommandParameter="{Binding Name}" />
                  <Button Content="{Binding #RoomInfoRoot.DataContext.KillCommandDisplay}" Classes="mud-small mud-danger" Padding="6,1"
                          Command="{Binding #RoomInfoRoot.DataContext.KillPersonCommand}"
                          CommandParameter="{Binding Name}" />
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                           Text="{Binding FightingText}"
                           Foreground="{StaticResource MudBrushCrimsonBright}"
                           IsVisible="{Binding IsFighting}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Android tile view -->
        <ItemsControl ItemsSource="{Binding People}" IsVisible="{Binding IsAndroidView}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:PersonEntry">
              <Button Width="65" Height="65"
                      Background="{StaticResource MudBrushVoid}"
                      BorderBrush="{StaticResource MudBrushGoldDim}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Margin="4"
                      Padding="2"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch">
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem Header="exam"
                              IsVisible="{Binding !IsSelf}"
                              Command="{Binding #RoomInfoRoot.DataContext.ExaminePersonCommand}"
                              CommandParameter="{Binding Name}" />
                    <MenuItem Header="{Binding #RoomInfoRoot.DataContext.KillCommandDisplay}"
                              IsVisible="{Binding !IsSelf}"
                              Command="{Binding #RoomInfoRoot.DataContext.KillPersonCommand}"
                              CommandParameter="{Binding Name}" />
                  </MenuFlyout>
                </Button.Flyout>
                
                <Grid RowDefinitions="*,Auto">
                  <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly">
                    <TextBlock Text="{Binding Name}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="80" />
                  </Viewbox>
                  <TextBlock Grid.Row="1"
                             Text="{Binding FightingText}"
                             Foreground="{StaticResource MudBrushCrimsonBright}"
                             IsVisible="{Binding IsFighting}"
                             FontSize="8"
                             TextAlignment="Center"
                             TextWrapping="Wrap" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>

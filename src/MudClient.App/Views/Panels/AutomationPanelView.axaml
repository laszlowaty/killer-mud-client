<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudClient.App.ViewModels"
             xmlns:models="using:MudClient.App.Models"
             xmlns:controls="using:MudClient.App.Controls"
             x:Name="AutomationRoot"
             x:Class="MudClient.App.Views.Panels.AutomationPanelView"
             x:DataType="vm:MainWindowViewModel">
  <UserControl.Resources>
    <!-- Leaf template for a timer inside the folder tree. -->
    <DataTemplate x:Key="TimerItemTemplate" x:DataType="models:TimerEntry">
      <Border Classes="mud-section" Padding="10,8" Margin="0,2">
        <StackPanel Spacing="6">

          <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                        VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
              <Border Classes="mud-badge mud-badge-gold">
                <TextBlock Text="{Binding IntervalText, StringFormat='co {0}'}" />
              </Border>
              <Border Classes="mud-badge" IsVisible="{Binding IsGlobal}"
                      ToolTip.Tip="Wspólny dla wszystkich kont">
                <TextBlock Text="Globalny" />
              </Border>
              <Border Classes="mud-badge mud-badge-gold" IsVisible="{Binding IsAdvanced}">
                <TextBlock Text="JS" />
              </Border>
            </StackPanel>

            <ToggleButton Grid.Column="1" Classes="mud-switch"
                          IsChecked="{Binding IsEnabled, Mode=OneWay}"
                          Content="{Binding StatusText}"
                          Click="ToggleTimer_OnClick"
                          ToolTip.Tip="Włącz / wyłącz timer" />

            <Button Grid.Column="2"
                    Classes="mud-small"
                    Content="✎" Padding="6,2"
                    ToolTip.Tip="Edytuj timer"
                    Click="EditTimer_OnClick" />

            <Button Grid.Column="3"
                    Classes="mud-small"
                    Content="⇩" Padding="6,2"
                    ToolTip.Tip="Eksportuj timer do JSON"
                    Click="ExportItem_OnClick" />

            <Button Grid.Column="4"
                    Classes="mud-small mud-danger"
                    Content="✕" Padding="6,2"
                    ToolTip.Tip="Usuń timer"
                    Click="DeleteTimer_OnClick" />
          </Grid>


          <TextBlock Text="{Binding LastError}"
                     Foreground="{StaticResource MudBrushCrimsonBright}"
                     TextWrapping="Wrap" IsVisible="{Binding HasLastError}" />

        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- Shared item template for aliases and triggers (rendered in two sections). -->
    <DataTemplate x:Key="RuleItemTemplate" x:DataType="models:AutomationRuleEntry">
      <Border Classes="mud-section" Padding="10,8" Margin="0,2">
        <StackPanel Spacing="4">

          <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
            <TextBlock Grid.Column="0" Text="{Binding Name}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource MudBrushParchment}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <Border Grid.Column="1" Classes="mud-badge mud-badge-gold" IsVisible="{Binding IsGlobal}"
                    ToolTip.Tip="Wspólna dla wszystkich kont">
              <TextBlock Text="Globalna" />
            </Border>
            <Border Grid.Column="2" Classes="mud-badge" IsVisible="{Binding IsAdvanced}">
              <TextBlock Text="JS" />
            </Border>
            <ToggleButton Grid.Column="3" Classes="mud-switch"
                          IsChecked="{Binding IsEnabled, Mode=OneWay}"
                          Content="{Binding StatusText}"
                          Click="ToggleRule_OnClick"
                          ToolTip.Tip="Włącz / wyłącz regułę" />
            <Button Grid.Column="4"
                    Classes="mud-small"
                    Content="✎" Padding="6,2"
                    ToolTip.Tip="Edytuj regułę"
                    Click="EditRule_OnClick" />
            <Button Grid.Column="5"
                    Classes="mud-small"
                    Content="⇩" Padding="6,2"
                    ToolTip.Tip="Eksportuj wpis do JSON"
                    Click="ExportItem_OnClick" />
            <Button Grid.Column="6"
                    Classes="mud-small mud-danger"
                    Content="✕" Padding="6,2"
                    ToolTip.Tip="Usuń regułę"
                    Click="DeleteRule_OnClick" />
          </Grid>

          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" RowDefinitions="Auto" RowSpacing="1">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="mud-faint" Text="Wzorzec" />
            <TextBlock Grid.Row="0" Grid.Column="1" Classes="mud-faint"
                       Text="{Binding Pattern}" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Pattern}" />
          </Grid>

        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ScriptItemTemplate" x:DataType="models:ScriptEntry">
      <Border Classes="mud-section" Padding="10,8" Margin="0,2">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
              <Border Classes="mud-badge"><TextBlock Text="JS" /></Border>
              <Border Classes="mud-badge mud-badge-gold" IsVisible="{Binding IsGlobal}">
                <TextBlock Text="Globalny" />
              </Border>
            </StackPanel>
            <ToggleButton Grid.Column="1" Classes="mud-switch"
                          IsChecked="{Binding IsEnabled, Mode=OneWay}"
                          Content="{Binding StatusText}"
                          Click="ToggleScript_OnClick" />
            <Button Grid.Column="2" Classes="mud-small" Content="▶" Padding="6,2"
                    ToolTip.Tip="Uruchom skrypt"
                    Click="RunScript_OnClick" />
            <Button Grid.Column="3" Classes="mud-small" Content="✎" Padding="6,2"
                    ToolTip.Tip="Edytuj skrypt"
                    Click="EditScript_OnClick" />
            <Button Grid.Column="4" Classes="mud-small" Content="⇩" Padding="6,2"
                    ToolTip.Tip="Eksportuj skrypt do JSON"
                    Click="ExportItem_OnClick" />
            <Button Grid.Column="5" Classes="mud-small mud-danger" Content="✕" Padding="6,2"
                    ToolTip.Tip="Usuń skrypt"
                    Click="DeleteScript_OnClick" />
          </Grid>
          <TextBlock Text="{Binding LastError}"
                     Foreground="{StaticResource MudBrushCrimsonBright}"
                     TextWrapping="Wrap" IsVisible="{Binding HasLastError}" />
          <TextBlock Text="{Binding GmcpPattern, StringFormat='GMCP: {0}'}"
                     Classes="mud-faint" />

        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="TimerEditorTemplate" x:DataType="vm:MainWindowViewModel">
      <StackPanel Spacing="8">
        <TextBox Text="{Binding NewTimerName}" PlaceholderText="Nazwa timera…" />
        <StackPanel Spacing="3">
          <TextBlock Classes="mud-faint" Text="Interwał powtarzania" />
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
            <TextBox Grid.Column="0" Text="{Binding NewTimerMinutes}" PlaceholderText="0" InnerRightContent="min" />
            <TextBox Grid.Column="1" Text="{Binding NewTimerSeconds}" PlaceholderText="0" InnerRightContent="s" />
            <TextBox Grid.Column="2" Text="{Binding NewTimerMilliseconds}" PlaceholderText="0" InnerRightContent="ms" />
          </Grid>
        </StackPanel>
        <StackPanel Spacing="3">
          <CheckBox IsChecked="{Binding NewTimerIsAdvanced}"
                    Content="Zaawansowany — kod JavaScript" />
          <TextBlock Classes="mud-faint"
                     Text="Komendy w osobnych liniach albo kod JavaScript w trybie zaawansowanym" />
          <controls:FullscreenTextEditor Text="{Binding NewTimerCommands}"
                                         EditorTitle="Komendy timera"
                                         IsJavaScript="{Binding NewTimerIsAdvanced}"
                                         PlaceholderText="np.&#x0a;rzuc 'leczenie'&#x0a;pij miksture"
                                         MinHeight="76" TextWrapping="Wrap" />
        </StackPanel>
        <CheckBox IsChecked="{Binding NewTimerIsGlobal}"
                  Content="Globalny — dostępny na wszystkich kontach" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <Button Content="{Binding TimerFormButtonText}" Command="{Binding AddTimerCommand}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button Grid.Column="1" Content="Anuluj" Command="{Binding CancelTimerEditCommand}" />
        </Grid>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="RuleEditorTemplate" x:DataType="vm:MainWindowViewModel">
      <StackPanel Spacing="8">
        <TextBox Text="{Binding NewRuleName}" PlaceholderText="Nazwa…" />
        <StackPanel Spacing="3">
          <TextBlock Classes="mud-faint" Text="Wzorzec (regex .NET)" />
          <TextBox Text="{Binding NewRulePattern}"
                   PlaceholderText="np. ^zb (.+)$  albo  (\w+) upada na ziemie" />
          <TextBlock Text="{Binding NewRulePatternError}"
                     Foreground="{StaticResource MudBrushCrimsonBright}"
                     TextWrapping="Wrap" IsVisible="{Binding HasNewRulePatternError}" />
        </StackPanel>
        <StackPanel Spacing="3">
          <CheckBox IsChecked="{Binding NewRuleIsAdvanced}"
                    Content="Zaawansowany — kod JavaScript" />
          <TextBlock Classes="mud-faint"
                     Text="Akcja — komendy i grupy $1, $2 albo kod JavaScript z obiektem match" />
          <controls:FullscreenTextEditor Text="{Binding NewRuleAction}"
                                         EditorTitle="Akcja aliasu lub triggera"
                                         IsJavaScript="{Binding NewRuleIsAdvanced}"
                                         PlaceholderText="np.&#x0a;rzuc 'leczenie' $1&#x0a;pij miksture"
                                         MinHeight="76" TextWrapping="Wrap" />
        </StackPanel>
        <CheckBox IsChecked="{Binding NewRuleIsGlobal}"
                  Content="Globalny — dostępny na wszystkich kontach" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <Button Content="{Binding RuleFormButtonText}" Command="{Binding AddRuleCommand}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button Grid.Column="1" Content="Anuluj" Command="{Binding CancelRuleEditCommand}" />
        </Grid>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <TabControl Classes="mud-subtabs mud-automation-tabs"
              SelectedIndex="{Binding SelectedAutomationTabIndex, Mode=TwoWay}">
    <TabItem>
      <TabItem.Header>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Timery" />
          <Border Classes="mud-badge"><TextBlock Text="{Binding Timers.Count}" /></Border>
        </StackPanel>
      </TabItem.Header>
      <Grid RowDefinitions="Auto,*">
        <Border Classes="mud-bar-bottom">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
            <Button Content="＋ Nowy timer" Command="{Binding StartAddTimerCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Grid.Column="1" Classes="mud-small" Content="📁 Folder"
                    ToolTip.Tip="Utwórz folder na timery"
                    Command="{Binding CreateFolderCommand}"
                    CommandParameter="{x:Static models:FolderKind.Timers}" />
            <Button Grid.Column="2" Classes="mud-small" Content="⇧ JSON"
                    ToolTip.Tip="Importuj timery lub folder z pliku JSON"
                    Tag="{x:Static models:FolderKind.Timers}" Click="Import_OnClick" />
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="8" Margin="10,8,10,12">

      <Expander Classes="mud-expander"
                Header="{Binding TimerFormHeader}"
                IsExpanded="{Binding IsTimerFormExpanded}"
                IsVisible="{Binding IsTimerFormExpanded}">
        <ContentControl Content="{Binding}"
                        ContentTemplate="{StaticResource TimerEditorTemplate}"
                        Margin="0,8,0,0" />
      </Expander>

      <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                 Text="Brak timerów. Timer powtarza komendy w nieskończoność, dopóki go nie wyłączysz."
                 IsVisible="{Binding !Timers.Count}" />

      <controls:FolderTreeView Nodes="{Binding TimerTree}"
                               ItemTemplate="{StaticResource TimerItemTemplate}"
                               SupportsEnableToggle="True"
                               SupportsExport="True"
                               FolderExportRequested="FolderTree_OnFolderExportRequested"
                               MoveIntoFolderCommand="{Binding MoveIntoFolderCommand}"
                               CreateSubfolderCommand="{Binding CreateSubfolderCommand}"
                               RenameFolderCommand="{Binding RenameFolderCommand}"
                               DeleteFolderCommand="{Binding ConfirmDeleteFolderCommand, ElementName=AutomationRoot}"
                               ToggleFolderGlobalCommand="{Binding ToggleFolderGlobalCommand}"
                               ToggleFolderEnabledCommand="{Binding ToggleFolderEnabledCommand}" />

          </StackPanel>
        </ScrollViewer>
      </Grid>
    </TabItem>

    <TabItem>
      <TabItem.Header>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Aliasy" />
          <Border Classes="mud-badge"><TextBlock Text="{Binding AliasRules.Count}" /></Border>
        </StackPanel>
      </TabItem.Header>
      <Grid RowDefinitions="Auto,*">
        <Border Classes="mud-bar-bottom">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
            <Button Content="＋ Nowy alias" Command="{Binding StartAddAliasCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Grid.Column="1" Classes="mud-small" Content="📁 Folder"
                    ToolTip.Tip="Utwórz folder na aliasy"
                    Command="{Binding CreateFolderCommand}"
                    CommandParameter="{x:Static models:FolderKind.Aliases}" />
            <Button Grid.Column="2" Classes="mud-small" Content="⇧ JSON"
                    ToolTip.Tip="Importuj alias lub folder z pliku JSON"
                    Tag="{x:Static models:FolderKind.Aliases}" Click="Import_OnClick" />
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="8" Margin="10,8,10,12">
            <Expander Classes="mud-expander"
                      Header="{Binding RuleFormHeader}"
                      IsExpanded="{Binding IsRuleFormExpanded}"
                      IsVisible="{Binding IsAliasRuleFormVisible}">
              <ContentControl Content="{Binding}"
                              ContentTemplate="{StaticResource RuleEditorTemplate}"
                              Margin="0,8,0,0" />
            </Expander>

      <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                 Text="Brak aliasów. Alias podmienia komendę, którą wpisujesz (np. skrót)."
                 IsVisible="{Binding !AliasRules.Count}" />

      <controls:FolderTreeView Nodes="{Binding AliasTree}"
                               ItemTemplate="{StaticResource RuleItemTemplate}"
                               SupportsEnableToggle="True"
                               SupportsExport="True"
                               FolderExportRequested="FolderTree_OnFolderExportRequested"
                               MoveIntoFolderCommand="{Binding MoveIntoFolderCommand}"
                               CreateSubfolderCommand="{Binding CreateSubfolderCommand}"
                               RenameFolderCommand="{Binding RenameFolderCommand}"
                               DeleteFolderCommand="{Binding ConfirmDeleteFolderCommand, ElementName=AutomationRoot}"
                               ToggleFolderGlobalCommand="{Binding ToggleFolderGlobalCommand}"
                               ToggleFolderEnabledCommand="{Binding ToggleFolderEnabledCommand}" />

          </StackPanel>
        </ScrollViewer>
      </Grid>
    </TabItem>

    <TabItem>
      <TabItem.Header>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Triggery" />
          <Border Classes="mud-badge"><TextBlock Text="{Binding TriggerRules.Count}" /></Border>
        </StackPanel>
      </TabItem.Header>
      <Grid RowDefinitions="Auto,*">
        <Border Classes="mud-bar-bottom">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
            <Button Content="＋ Nowy trigger" Command="{Binding StartAddTriggerCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Grid.Column="1" Classes="mud-small" Content="📁 Folder"
                    ToolTip.Tip="Utwórz folder na triggery"
                    Command="{Binding CreateFolderCommand}"
                    CommandParameter="{x:Static models:FolderKind.Triggers}" />
            <Button Grid.Column="2" Classes="mud-small" Content="⇧ JSON"
                    ToolTip.Tip="Importuj trigger lub folder z pliku JSON"
                    Tag="{x:Static models:FolderKind.Triggers}" Click="Import_OnClick" />
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="8" Margin="10,8,10,12">
            <Expander Classes="mud-expander"
                      Header="{Binding RuleFormHeader}"
                      IsExpanded="{Binding IsRuleFormExpanded}"
                      IsVisible="{Binding IsTriggerRuleFormVisible}">
              <ContentControl Content="{Binding}"
                              ContentTemplate="{StaticResource RuleEditorTemplate}"
                              Margin="0,8,0,0" />
            </Expander>

      <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                 Text="Brak triggerów. Trigger wysyła akcję, gdy linia z serwera pasuje do wzorca."
                 IsVisible="{Binding !TriggerRules.Count}" />

      <controls:FolderTreeView Nodes="{Binding TriggerTree}"
                               ItemTemplate="{StaticResource RuleItemTemplate}"
                               SupportsEnableToggle="True"
                               SupportsExport="True"
                               FolderExportRequested="FolderTree_OnFolderExportRequested"
                               MoveIntoFolderCommand="{Binding MoveIntoFolderCommand}"
                               CreateSubfolderCommand="{Binding CreateSubfolderCommand}"
                               RenameFolderCommand="{Binding RenameFolderCommand}"
                               DeleteFolderCommand="{Binding ConfirmDeleteFolderCommand, ElementName=AutomationRoot}"
                               ToggleFolderGlobalCommand="{Binding ToggleFolderGlobalCommand}"
                               ToggleFolderEnabledCommand="{Binding ToggleFolderEnabledCommand}" />

          </StackPanel>
        </ScrollViewer>
      </Grid>
    </TabItem>

    <TabItem>
      <TabItem.Header>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Skrypty" />
          <Border Classes="mud-badge"><TextBlock Text="{Binding Scripts.Count}" /></Border>
        </StackPanel>
      </TabItem.Header>
      <Grid RowDefinitions="Auto,*">
        <Border Classes="mud-bar-bottom">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
            <Button Content="＋ Nowy skrypt" Command="{Binding StartAddScriptCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Grid.Column="1" Classes="mud-small" Content="📁 Folder"
                    Command="{Binding CreateFolderCommand}"
                    CommandParameter="{x:Static models:FolderKind.Scripts}" />
            <Button Grid.Column="2" Classes="mud-small" Content="⇧ JSON"
                    Tag="{x:Static models:FolderKind.Scripts}" Click="Import_OnClick" />
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="8" Margin="10,8,10,12">
            <Expander Classes="mud-expander"
                      Header="{Binding ScriptFormHeader}"
                      IsExpanded="{Binding IsScriptFormExpanded}"
                      IsVisible="{Binding IsScriptFormExpanded}">
              <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBox Text="{Binding NewScriptName}" PlaceholderText="Nazwa skryptu…" />
                <TextBox Text="{Binding NewScriptGmcpPattern}"
                         PlaceholderText="Pakiet GMCP, np. Char.Vitals lub Char.* (puste = tylko ręcznie)" />
                <TextBlock Classes="mud-faint"
                           Text="JavaScript: onGmcp(), execute(), send(), echo(), reconnect(), variables" />
                <controls:FullscreenTextEditor Text="{Binding NewScriptCode}"
                                               EditorTitle="Kod JavaScript"
                                               IsJavaScript="True"
                                               TextWrapping="NoWrap"
                                               MinHeight="150"
                                               PlaceholderText="onGmcp(&quot;Char.Vitals&quot;, event => {&#x0a;  if (event.data.hp &lt; 25) execute(&quot;/idz lecznica&quot;);&#x0a;});" />
                <CheckBox IsChecked="{Binding NewScriptIsGlobal}"
                          Content="Globalny — dostępny na wszystkich kontach" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <Button Content="{Binding ScriptFormButtonText}"
                          Command="{Binding AddScriptCommand}" />
                  <Button Grid.Column="1" Content="Anuluj"
                          Command="{Binding CancelScriptEditCommand}" />
                </Grid>
              </StackPanel>
            </Expander>

            <controls:FolderTreeView Nodes="{Binding ScriptTree}"
                                     ItemTemplate="{StaticResource ScriptItemTemplate}"
                                     SupportsEnableToggle="True"
                                     SupportsExport="True"
                                     FolderExportRequested="FolderTree_OnFolderExportRequested"
                                     MoveIntoFolderCommand="{Binding MoveIntoFolderCommand}"
                                     CreateSubfolderCommand="{Binding CreateSubfolderCommand}"
                                     RenameFolderCommand="{Binding RenameFolderCommand}"
                                     DeleteFolderCommand="{Binding ConfirmDeleteFolderCommand, ElementName=AutomationRoot}"
                                     ToggleFolderGlobalCommand="{Binding ToggleFolderGlobalCommand}"
                                     ToggleFolderEnabledCommand="{Binding ToggleFolderEnabledCommand}" />

            <Border Classes="mud-section" Padding="10">
              <StackPanel Spacing="8">
                <TextBlock Classes="mud-heading" Text="Zmienne profilu" />
                <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                           Text="Wspólne dla skryptów, aliasów, triggerów i timerów. Wartość musi być prawidłowym JSON-em." />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                  <TextBox Text="{Binding NewScriptVariableName}"
                           PlaceholderText="Nazwa, np. combat.target" />
                  <TextBox Grid.Column="1" Text="{Binding NewScriptVariableJson}"
                           PlaceholderText="Wartość JSON, np. &quot;ork&quot;" />
                </Grid>
                <Button Content="Zapisz zmienną"
                        Command="{Binding AddScriptVariableCommand}" />
                <ItemsControl ItemsSource="{Binding ScriptVariables}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ScriptVariableEntry">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding ValueJson}"
                                   Classes="mud-faint" TextWrapping="Wrap" />
                        <Button Grid.Column="2" Classes="mud-small mud-danger" Content="✕"
                                Command="{Binding $parent[UserControl].DataContext.DeleteScriptVariableCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </TabItem>

    <TabItem Header="Drużyna">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="8" Margin="10,8,10,12">
          <TextBlock Classes="mud-heading" Text="Automaty drużynowe" />
          <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                     Text="Automatyczne reakcje na stan drużyny i komunikaty z gry." />

          <Border Classes="mud-section" Padding="10">
            <StackPanel Spacing="10">
              <StackPanel Spacing="3">
                <CheckBox IsChecked="{Binding AutoAssistEnabled}"
                          Content="Autoassist — automatyczne wspieranie drużyny" />
                <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                           Text="Gdy GMCP wykryje, że inny członek drużyny walczy w tym samym pokoju, klient wyśle „as”. Jeśli przestaniesz walczyć, a członek drużyny nadal walczy, komenda zostanie ponowiona." />
                <TextBlock Margin="0,6,0,0"
                           Text="Komendy po asyście" />
                <TextBox MinHeight="64"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         PlaceholderText="Np. wesprzyj;czar 'ochrona'"
                         Text="{Binding AutoAssistFollowUpCommands, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                           Text="Wysyłane po komendzie „as”. Możesz wpisać wiele wierszy lub rozdzielić komendy separatorem ustawionym w opcjach klienta." />
                <TextBlock Margin="0,6,0,0"
                           Text="Moby wykluczone z autoassista" />
                <TextBox MinHeight="64"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         PlaceholderText="Dokładna nazwa moba — po jednej w wierszu"
                         Text="{Binding AutoAssistExcludedMobNamesText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                           Text="Klient nie wyśle „as”, gdy członek grupy w aktualnym pokoju walczy z mobem o jednej z tych nazw. Dopasowanie obejmuje całą nazwę i nie rozróżnia wielkości liter." />
              </StackPanel>

              <StackPanel Spacing="3">
                <CheckBox IsChecked="{Binding GroupOrdersEnabled}"
                          Content="Ordery — wykonuj rozkazy członków drużyny" />
                <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                           Text="Klient wykona komendę z komunikatu „Gracz rozkazuje ci 'komenda'.” tylko wtedy, gdy Gracz znajduje się w aktualnej grupie GMCP." />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</UserControl>

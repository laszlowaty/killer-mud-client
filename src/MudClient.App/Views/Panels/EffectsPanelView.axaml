<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudClient.App.ViewModels"
             xmlns:models="using:MudClient.App.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="MudClient.App.Views.Panels.EffectsPanelView"
             x:DataType="vm:MainWindowViewModel">
  <UserControl.Styles>
    <Style Selector="Border.effect-entry">
      <Setter Property="BorderBrush" Value="{StaticResource MudBrushEmerald}" />
    </Style>
    <Style Selector="Border.effect-entry.debuff">
      <Setter Property="BorderBrush" Value="{StaticResource MudBrushCrimson}" />
    </Style>
    <Style Selector="Border.effect-entry.ending">
      <Setter Property="BorderBrush" Value="{StaticResource MudBrushCrimson}" />
    </Style>
    <Style Selector="TextBlock.effect-icon">
      <Setter Property="Foreground" Value="{StaticResource MudBrushEmeraldBright}" />
    </Style>
    <Style Selector="TextBlock.effect-icon.debuff">
      <Setter Property="Foreground" Value="{StaticResource MudBrushCrimsonBright}" />
    </Style>
    <Style Selector="TextBlock.effect-icon.ending">
      <Setter Property="Foreground" Value="{StaticResource MudBrushCrimsonBright}" />
    </Style>
    <Style Selector="TextBlock.effect-name.debuff">
      <Setter Property="Foreground" Value="{StaticResource MudBrushCrimsonBright}" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer>
    <StackPanel Spacing="10" Margin="12">
      <!-- Condition (live from Char.Condition GMCP) -->
      <StackPanel Spacing="4">
        <TextBlock Classes="mud-heading" Text="Kondycja" />
        <TextBlock Classes="mud-faint" Text="W pełni sił — brak dolegliwości."
                   IsVisible="{Binding !Conditions.Count}" />
        <ItemsControl ItemsSource="{Binding Conditions}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Border Background="{StaticResource MudBrushStoneLight}"
                      BorderBrush="{StaticResource MudBrushCrimson}"
                      BorderThickness="1"
                      CornerRadius="3" Padding="7,3" Margin="0,2,4,2">
                <TextBlock Text="{Binding}"
                           Foreground="{StaticResource MudBrushCrimsonBright}" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Effects (live from Char.Affects GMCP) -->
      <StackPanel Spacing="2">
        <TextBlock Classes="mud-heading" Text="Efekty" />
        <TextBlock Classes="mud-faint" Text="Brak aktywnych efektów."
                   IsVisible="{Binding !Effects.Count}" />
        <ItemsControl ItemsSource="{Binding Effects}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:StatusEffect">
            <Border Classes="effect-entry"
                    Classes.debuff="{Binding IsDebuff}"
                    Classes.ending="{Binding Ending}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="6,3"
                    Margin="0,1">
              <Grid ColumnDefinitions="Auto,*"
                    RowDefinitions="Auto,Auto">
                <TextBlock Grid.Column="0" Grid.Row="0"
                           Classes="effect-icon"
                           Classes.debuff="{Binding IsDebuff}"
                           Classes.ending="{Binding Ending}"
                           Text="{Binding Icon}"
                           Margin="0,0,6,0" />
                <StackPanel Grid.Column="1" Grid.Row="0"
                            Orientation="Horizontal" Spacing="4">
                  <TextBlock Classes="effect-name"
                             Classes.debuff="{Binding IsDebuff}"
                             Text="{Binding Name}"
                             ToolTip.Tip="{Binding Description}" />
                  <TextBlock Text="{Binding Duration, StringFormat='({0})'}"
                             Classes="mud-faint">
                    <TextBlock.IsVisible>
                      <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                        <Binding Path="HasDuration" />
                        <Binding Path="$parent[ItemsControl].DataContext.ShowExtendedEffects" />
                      </MultiBinding>
                    </TextBlock.IsVisible>
                  </TextBlock>
                </StackPanel>
                <TextBlock Grid.Column="1" Grid.Row="1"
                           Text="{Binding Description}"
                           Classes="mud-faint"
                           TextTrimming="CharacterEllipsis">
                  <TextBlock.IsVisible>
                    <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                      <Binding Path="HasDescription" />
                      <Binding Path="$parent[ItemsControl].DataContext.ShowExtendedEffects" />
                    </MultiBinding>
                  </TextBlock.IsVisible>
                </TextBlock>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>

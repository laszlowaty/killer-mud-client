<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:MudClient.App.Models"
             xmlns:vm="using:MudClient.App.ViewModels"
             x:Class="MudClient.App.Views.Panels.ScriptVariablesPanelView"
             x:DataType="vm:MainWindowViewModel">
  <Grid Margin="8">
    <TextBlock Classes="mud-faint"
               TextWrapping="Wrap"
               Text="Aktywny profil nie ma jeszcze zmiennych skryptowych."
               IsVisible="{Binding !ScriptVariables.Count}" />

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  IsVisible="{Binding ScriptVariables.Count}">
      <ItemsControl ItemsSource="{Binding ScriptVariables}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:ScriptVariableEntry">
            <Border Classes="mud-section" Padding="8,6" Margin="0,2">
              <Grid RowDefinitions="Auto,Auto">
                <SelectableTextBlock Grid.Row="0"
                                     FontWeight="Bold"
                                     Foreground="{StaticResource MudBrushArcaneBlueBright}"
                                     Text="{Binding Name}" />
                <SelectableTextBlock Grid.Row="1"
                                     Margin="0,3,0,0"
                                     Classes="mud-muted"
                                     FontFamily="Consolas"
                                     TextWrapping="Wrap"
                                     Text="{Binding ValueJson}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>

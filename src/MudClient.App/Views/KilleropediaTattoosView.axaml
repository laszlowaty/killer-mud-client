<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudClient.App.ViewModels"
             xmlns:models="using:MudClient.App.Models"
             xmlns:b="using:MudClient.App.Behaviors"
             x:Class="MudClient.App.Views.KilleropediaTattoosView"
             x:DataType="vm:KilleropediaViewModel"
             Classes="killeropedia-page"
             x:Name="Root">
  <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <TextBox Grid.Column="0"
               Text="{Binding TattooSearchText, UpdateSourceTrigger=PropertyChanged}"
               PlaceholderText="Szukaj bonusu, klasy albo opisu..." />
      <TextBlock Grid.Column="1"
                 Classes="mud-faint"
                 Text="{Binding FilteredTattooCountText}"
                 VerticalAlignment="Center" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBlock Grid.Column="0"
                 Classes="mud-muted"
                 Text="{Binding TattooIntro}"
                 TextWrapping="Wrap" />
      <Button Grid.Column="1"
              Classes="mud-small"
              Command="{Binding ToggleTattooInfoCommand}"
              Content="Jak działają tatuaże"
              VerticalAlignment="Top" />
    </Grid>

    <Border Grid.Row="2"
            Classes="mud-section"
            Padding="14"
            IsVisible="{Binding IsTattooInfoExpanded}">
      <StackPanel Spacing="10">
        <StackPanel Spacing="4">
          <TextBlock Classes="mud-heading" Text="RODZAJE RUN" />
          <ItemsControl ItemsSource="{Binding TattooRuneTypes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:TattooRuneEntry">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                  <TextBlock Classes="mud-muted" Text="{Binding Description}" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Classes="mud-heading" Text="KOMENDY" />
          <ItemsControl ItemsSource="{Binding TattooCommands}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:TattooCommandEntry">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                  <TextBlock FontWeight="SemiBold"
                             Foreground="{StaticResource MudBrushGoldBright}"
                             Text="{Binding Name}" />
                  <TextBlock Classes="mud-muted" Text="{Binding Description}" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Classes="mud-heading" Text="NAKŁADANIE I KUMULACJA" />
          <TextBlock Classes="mud-muted" Text="{Binding TattooStackingNotes}" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="3"
            Classes="mud-section"
            Padding="18"
            IsVisible="{Binding HasNoTattooResults}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <TextBlock Classes="mud-heading-lg" Text="Brak pasujących bonusów" HorizontalAlignment="Center" />
        <TextBlock Classes="mud-muted"
                   Text="Zmień wyszukiwaną frazę albo wybierz inną klasę."
                   TextWrapping="Wrap"
                   TextAlignment="Center" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="3"
          ColumnDefinitions="1*,3,2*"
          IsVisible="{Binding !HasNoTattooResults}">
      <Border Grid.Column="0" Classes="mud-inset killeropedia-left-page" Padding="12">
        <ListBox ItemsSource="{Binding FilteredTattoos}"
                 SelectedItem="{Binding SelectedTattoo}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:TattooBonusEntry">
              <Border Padding="10,7" Margin="0,1" CornerRadius="3">
                <StackPanel Spacing="3">
                  <TextBlock FontWeight="SemiBold"
                             b:SearchHighlight.Text="{Binding Name}"
                             b:SearchHighlight.Terms="{Binding #Root.((vm:KilleropediaViewModel)DataContext).TattooSearchText}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="mud-faint"
                             b:SearchHighlight.Text="{Binding ClassesText}"
                             b:SearchHighlight.Terms="{Binding #Root.((vm:KilleropediaViewModel)DataContext).TattooSearchText}"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <Border Grid.Column="2" Classes="mud-section killeropedia-right-page" Padding="22">
        <ScrollViewer Classes="killeropedia-content-scroll">
          <StackPanel Spacing="14" DataContext="{Binding SelectedTattoo}">
            <TextBlock Classes="mud-heading-lg"
                       b:SearchHighlight.Text="{Binding Name}"
                       b:SearchHighlight.Terms="{Binding #Root.((vm:KilleropediaViewModel)DataContext).TattooSearchText}"
                       TextWrapping="Wrap" />

            <Border Classes="mud-inset" Padding="11">
              <StackPanel Spacing="5">
                <TextBlock Classes="mud-heading" Text="KLASA" />
                <TextBlock b:SearchHighlight.Text="{Binding ClassesText}"
                           b:SearchHighlight.Terms="{Binding #Root.((vm:KilleropediaViewModel)DataContext).TattooSearchText}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="mud-inset" Padding="11">
              <StackPanel Spacing="5">
                <TextBlock Classes="mud-heading" Text="DZIAŁANIE" />
                <TextBlock b:SearchHighlight.Text="{Binding Description}"
                           b:SearchHighlight.Terms="{Binding #Root.((vm:KilleropediaViewModel)DataContext).TattooSearchText}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>

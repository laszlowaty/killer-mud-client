<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudClient.App.ViewModels"
             x:Class="MudClient.App.Controls.TerminalOverlayHost"
             x:DataType="vm:MainWindowViewModel">
  <!--
    Renders every panel pinned as a Terminal overlay (MainWindowViewModel.TerminalOverlays, only
    ever populated in TRANSPARENCY mode) as two independently resizable stacks flanking the
    Terminal — which always stays centered — one per TerminalOverlayViewModel.Side. Resize
    handles are plain Border elements driven by hand-rolled pointer-drag code in
    TerminalOverlayHost.axaml.cs — Avalonia's GridSplitter proved unreliable for resizing two
    star-sized siblings here, so this computes fractions/weights directly from pointer deltas
    instead (see PointerMoved handlers). Each handle is a wide (6px) transparent hit area around a
    barely-visible 1px line, brightening on hover, so it stays easy to grab without dominating
    the view.
    RootGrid columns: left stack | left width handle | center passthrough (Terminal) |
    right width handle | right stack.
    Each StackArea's rows: card stack | height handle | empty passthrough below (revealed by
    shrinking that side's height fraction — the handle sits right below its lowest card).
    Areas with no Background pass pointer input straight through to the terminal.
  -->
  <UserControl.Styles>
    <Style Selector="Border.mud-overlay-handle-line">
      <Setter Property="Background" Value="{StaticResource MudBrushGoldDim}" />
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Border.mud-overlay-handle:pointerover Border.mud-overlay-handle-line">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>
  <Grid x:Name="RootGrid" ColumnDefinitions="*,6,*,6,*">
    <Grid x:Name="LeftStackArea" Grid.Column="0" MinWidth="160" RowDefinitions="*,6,*">
      <Grid x:Name="LeftOverlayColumn" Grid.Row="0" />
      <Border x:Name="LeftHeightHandle" Grid.Row="1"
              Classes="mud-overlay-handle"
              Background="Transparent"
              Cursor="SizeNorthSouth">
        <Border Classes="mud-overlay-handle-line"
                Height="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
      </Border>
    </Grid>

    <Border x:Name="LeftWidthHandle" Grid.Column="1"
            Classes="mud-overlay-handle"
            Background="Transparent"
            Cursor="SizeWestEast">
      <Border Classes="mud-overlay-handle-line"
              Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" />
    </Border>

    <!-- Grid.Column="2": center passthrough, deliberately empty — the Terminal beneath always
         shows through here and stays visually centered regardless of either side's width. -->

    <Border x:Name="WidthHandle" Grid.Column="3"
            Classes="mud-overlay-handle"
            Background="Transparent"
            Cursor="SizeWestEast">
      <Border Classes="mud-overlay-handle-line"
              Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" />
    </Border>

    <Grid x:Name="StackArea" Grid.Column="4" MinWidth="160" RowDefinitions="*,6,*">
      <Grid x:Name="OverlayColumn" Grid.Row="0" />
      <Border x:Name="HeightHandle" Grid.Row="1"
              Classes="mud-overlay-handle"
              Background="Transparent"
              Cursor="SizeNorthSouth">
        <Border Classes="mud-overlay-handle-line"
                Height="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
      </Border>
    </Grid>
  </Grid>
</UserControl>

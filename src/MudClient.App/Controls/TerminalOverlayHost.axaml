<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudClient.App.ViewModels"
             x:Class="MudClient.App.Controls.TerminalOverlayHost"
             x:DataType="vm:MainWindowViewModel">
  <!--
    Renders every panel pinned as a Terminal overlay (MainWindowViewModel.TerminalOverlays, only
    ever populated in TRANSPARENCY mode) as a set of independently resizable columns floating on
    top of the Terminal, grouped by TerminalOverlayViewModel.ColumnIndex and laid out right-to-
    left: column 0 hugs the right edge, higher indices sit further left, closer to the Terminal's
    center. Moving a card left/right (see TerminalOverlayCard) moves it one column further from or
    closer to that edge, creating or collapsing columns as needed — see
    MainWindowViewModel.MoveOverlayColumn.
    This whole control is just one child of a Panel alongside the Terminal itself (see
    TerminalPanelView.axaml) — since the number of columns is dynamic, everything below ColumnsPanel
    is built in code-behind rather than static XAML, and none of it ever asks the Terminal to
    resize: columns only float semi-transparently on top of it (see TerminalOverlayOpacityResource).
    Resize handles are plain Border elements driven by hand-rolled pointer-drag code in
    TerminalOverlayHost.axaml.cs — Avalonia's GridSplitter proved unreliable for resizing
    star-sized siblings here, so this computes pixel deltas directly instead.
  -->
  <UserControl.Styles>
    <Style Selector="Border.mud-overlay-handle-line">
      <Setter Property="Background" Value="{StaticResource MudBrushGoldDim}" />
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Border.mud-overlay-handle:pointerover Border.mud-overlay-handle-line">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>
  <!-- Right margin reserves a slim strip at the Terminal's true right edge for its scrollback
       scrollbar (MudOutputView's ScrollbackScroller, AllowAutoHide="False") — without it, every
       overlay column (however many, however wide) hugs the right edge and paints over the
       scrollbar, since both are right-anchored in the same space. This keeps the columns
       "before" (left of) that strip regardless of column count/width, rather than needing to
       track the scrollbar's exact width dynamically. -->
  <StackPanel x:Name="ColumnsPanel" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,20,0" />
</UserControl>

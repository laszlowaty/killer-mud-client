<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudClient.App.ViewModels"
             x:Class="MudClient.App.Controls.FloatingButtonsOverlay"
             x:DataType="vm:MainWindowViewModel">
  <Canvas x:Name="FloatingButtonLayer"
          IsVisible="False"
          SizeChanged="FloatingButtonLayer_OnSizeChanged" />
</UserControl>
